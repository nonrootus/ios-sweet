 	uint64_t read_started = now_us();
-	glReadPixels(0, 0, image->width, image->height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	/* Large offscreen XR10 surfaces do not use the direct panel path. Read
+	 * them in strips to avoid a second full-size allocation in the GPU pool.
+	 * Keep all pixels in CPU scratch until the whole read succeeds. */
+	bool strip_read = IOSurfaceGetPixelFormat(surface) == SWEET_W30R_FORMAT && image->height > 256;
+	GLsizei step = strip_read ? 256 : image->height;
+	GLenum error = GL_NO_ERROR;
+	for (GLsizei y = 0; y < image->height; y += step) {
+		GLsizei rows = image->height - y < step ? image->height - y : step;
+		uint8_t *dst = pixels + (size_t)y * (size_t)image->width * 4;
+		glReadPixels(0, y, image->width, rows, GL_RGBA, GL_UNSIGNED_BYTE, dst);
+		error = glGetError();
+		if (error != GL_NO_ERROR) {
+			break;
+		}
+	}
 	uint64_t read_us = now_us() - read_started;
-	GLenum error = glGetError();
+	if (strip_read) {
+		static unsigned logs;
+		if (logs++ < 12) {
+			say("SWEET XR10: strip readback %dx%d, %llu us, error %#x\n",
+			    image->width, image->height, (unsigned long long)read_us, error);
+		}
+	}
 	b3a8_transfer_state(true, saved, true);
