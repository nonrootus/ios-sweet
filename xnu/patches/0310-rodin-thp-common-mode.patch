+static void
+thp_dump_raw(uint32_t n, uint32_t frames, uint32_t polls, uint32_t flen, bool event)
+{
+	static const char hx[] = "0123456789abcdef";
+	printf("RODIN THP DUMP %u frame %u poll %u len %u%s\n", n, frames, polls, flen, event ? " (touch event)" : "");
+	for (uint32_t o = 0; o < flen; o += 32) {
+		char line[3 * 32 + 1];
+		uint32_t k = 0;
+		for (uint32_t j = o; j < o + 32 && j < flen; j++, k += 3) {
+			line[k] = hx[thp_frame[j] >> 4];
+			line[k + 1] = hx[thp_frame[j] & 15];
+			line[k + 2] = ' ';
+		}
+		line[k] = 0;
+		printf("RODIN THP %u %04x: %s\n", n, o, line);
+	}
+}
+
+static void
+thp_dump_map(uint32_t n, uint32_t R, uint32_t C, int32_t thr)
+{
+	printf("RODIN THP MAP %u: residual per node (drive line per row), threshold %d\n", n, thr);
+	for (uint32_t r = 0; r < R; r++) {
+		char line[THP_MAP_COLS * 7 + 1];
+		uint32_t k = 0;
+		for (uint32_t c = 0; c < C && c < THP_MAP_COLS; c++) {
+			int32_t v = MIN(MAX(thp_d[r * C + c], -32767), 32767);
+			uint32_t u = (uint32_t)(v < 0 ? -v : v), nd = 0;
+			char t[6];
+			do {
+				t[nd++] = (char)('0' + u % 10);
+				u /= 10;
+			} while (u);
+			if (v < 0) {
+				line[k++] = '-';
+			}
+			while (nd) {
+				line[k++] = t[--nd];
+			}
+			line[k++] = ' ';
+		}
+		line[k] = 0;
+		printf("RODIN THP MAP %u r%02u: %s\n", n, r, line);
+	}
+}
