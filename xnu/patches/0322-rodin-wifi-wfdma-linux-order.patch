+		wr32(dma, 0x504 + r * 0x10, WF_RXN);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* 4. soc7_0 WfdmaManualPrefetch: chain mode off, prefetch slots, then reset the DMA pointers */
+	wr32(dma, 0x208, rd32(dma, 0x208) & ~(1u << 15));
 	uint32_t pf = 0x4;
