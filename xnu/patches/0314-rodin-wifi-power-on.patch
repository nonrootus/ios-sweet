+/*
+ * The only PMIC registers this file may write: the VTP enable (its other bits are kept) and, for
+ * Wi-Fi step 2 (rodinwifion=1, owner's yes 2026-11-21), the connectivity block's common supplies on
+ * MT6363 as conninfra's mt6899_pmic.c switches them on: VRFIO18 voltage, op-enable and enable,
+ * VCN13 op-enable and enable, the VS2 buck voltage (VBOCK0) and its voter set register.
+ */
+#define MT6363_VRFIO18_EN       0x1bcd  /* bit 0 enable, bit 1 low power */
+#define MT6363_VRFIO18_OPEN     0x1bd4  /* bit 7 SW_OP_EN */
+#define MT6363_VRFIO18_VOSEL    0x1f2c  /* bits 3:0, ldo_volt_table3: 11 = 1.7 V */
+#define MT6363_VCN13_EN         0x1d07
+#define MT6363_VCN13_OPEN       0x1d16
+#define MT6363_VBOCK0           0x024c  /* VS2 buck voltage: 0x74 = 1.45 V */
+#define MT6363_VS2_VOTER_SET    0x149b  /* bit 4 = connsys' vote */
 static bool
 rodin_pmic_writable(uint8_t sid, uint16_t addr)
 {
+	if (sid == MT6363_SID) {
+		return addr == MT6363_VRFIO18_EN || addr == MT6363_VRFIO18_OPEN || addr == MT6363_VRFIO18_VOSEL ||
+		       addr == MT6363_VCN13_EN || addr == MT6363_VCN13_OPEN || addr == MT6363_VBOCK0 ||
+		       addr == MT6363_VS2_VOTER_SET;
+	}
 	return sid == MT6368_SID && addr == MT6368_LDO_VTP_EN;
 }
 
