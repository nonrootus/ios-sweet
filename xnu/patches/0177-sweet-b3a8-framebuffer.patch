--- /dev/null
+++ b/iokit/Kernel/arm/sweet_b3a8.h
@@ -0,0 +1,51 @@
+#ifndef SWEET_B3A8_H
+#define SWEET_B3A8_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define SWEET_B3A8_FORMAT 0x62336138u
+
+/* BGR10_XR in a little-endian word, followed by a separate alpha plane.
+ * Apple BGR10_XR maps 8-bit SDR v to the exact XR code 384 + 2*v. */
+static inline uint8_t
+sweet_xr10_to_u8(uint32_t value)
+{
+    if (value <= 384) {
+        return 0;
+    }
+    if (value >= 894) {
+        return 255;
+    }
+    return (uint8_t)((value - 383) >> 1);
+}
+
+static inline uint32_t
+sweet_b3a8_pack(const uint8_t *rgba)
+{
+    uint32_t r = 384u + 2u * rgba[0];
+    uint32_t g = 384u + 2u * rgba[1];
+    uint32_t b = 384u + 2u * rgba[2];
+    return b | (g << 10) | (r << 20);
+}
+
+static inline void
+sweet_b3a8_unpack(uint32_t rgb, uint8_t alpha, uint8_t *pixel, int bgra)
+{
+    pixel[bgra ? 2 : 0] = sweet_xr10_to_u8((rgb >> 20) & 1023u);
+    pixel[1] = sweet_xr10_to_u8((rgb >> 10) & 1023u);
+    pixel[bgra ? 0 : 2] = sweet_xr10_to_u8(rgb & 1023u);
+    pixel[3] = alpha;
+}
+
+/* Validate the last touched byte without overflowing (height - 1) * stride. */
+static inline int
+sweet_b3a8_plane_fits(size_t offset, size_t stride, size_t row_bytes,
+    size_t height, size_t length)
+{
+    return height != 0 && row_bytes != 0 && offset <= length &&
+        stride >= row_bytes && row_bytes <= length - offset &&
+        height - 1 <= (length - offset - row_bytes) / stride;
+}
+
+#endif
