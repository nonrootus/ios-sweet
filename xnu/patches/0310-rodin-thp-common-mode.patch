+static int32_t
+thp_median(int32_t *v, uint32_t n)      /* sorts v: n is small */
+{
+	for (uint32_t i = 1; i < n; i++) {
+		int32_t x = v[i];
+		uint32_t j = i;
+		for (; j > 0 && v[j - 1] > x; j--) {
+			v[j] = v[j - 1];
+		}
+		v[j] = x;
+	}
+	return v[n / 2];
+}
+
+/* From one drive line (C values) subtracts the line through the medians of its THP_SEGS segments
+ * (piecewise linear, extrapolated at both ends): a finger covers 3-4 of a segment's 10 nodes, the
+ * median ignores it. */
+static void
+thp_common_mode(int32_t *row, uint32_t C)
+{
+	int32_t med[THP_SEGS], cen2[THP_SEGS], tmp[THP_MAP_COLS];
+	for (uint32_t s = 0; s < THP_SEGS; s++) {
+		uint32_t a = s * C / THP_SEGS, b = (s + 1) * C / THP_SEGS;
+		for (uint32_t c = a; c < b; c++) {
+			tmp[c - a] = row[c];
+		}
+		med[s] = thp_median(tmp, b - a);
+		cen2[s] = (int32_t)(a + b - 1);         /* twice the segment's centre */
+	}
+	for (uint32_t c = 0; c < C; c++) {
+		int32_t c2 = 2 * (int32_t)c;
+		uint32_t s = 0;
+		while (s + 2 < THP_SEGS && c2 > cen2[s + 1]) {
+			s++;
+		}
+		row[c] -= med[s] + (med[s + 1] - med[s]) * (c2 - cen2[s]) / (cen2[s + 1] - cen2[s]);
+	}
+}
