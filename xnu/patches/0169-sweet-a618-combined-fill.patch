+		if (entry->len && entry->pa < end && entry->pa + entry->len > base) {
+			return -1;
+		}
+	}
+	for (pmap_paddr_t pa = base; pa < end; pa += PAGE_SIZE) {
+		pmap_paddr_t mapped = kvtophys(gVirtBase - (gPhysBase - pa));
+		if (pmap_valid_page(atop(pa)) || (mapped >= base && mapped < end)) {
+			return -1;
+		}
+	}
+	return 0;
+}
 
