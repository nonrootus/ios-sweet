+/* Poll-thread only. Short packets let usbser deliver the stream promptly. */
+static void
+ud_serial_tx(void)
+{
+	if (!ud.configured || !ud.serial_dtr || ud.tx_busy) {
+		return;
+	}
+	uint64_t next = ud.serial_position;
+	uint32_t len = sweet_log_copy(&next, (char *)(ud.dma + UD_TX), 511);
+	if (len && !ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, len, TRBCTL_NORMAL)) {
+		ud.serial_position = next;
+		ud.tx_busy = true;
+	}
+}
