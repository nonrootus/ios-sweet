+/*
+ * IOSurfaceWrapClientImage (6: a struct of 0x20 bytes: +0 address, +8 width, +0xc height,
+ * +0x10 pixel format, +0x14 bytes per element, +0x18 bytes per row) and
+ * IOSurfaceWrapClientMemory (7: scalars address, size): a surface made of the caller's own
+ * memory. CoreAnimation's GL renderer wraps the shared memory of images, icons and wallpapers
+ * so; refused, it falls back on an empty surface and the picture is not there. The range is
+ * wired for as long as the surface lives, and every task maps it as usual.
+ */
+IOReturn
+IOSurfaceRootUserClient::wrapClient(uint32_t selector, IOExternalMethodArguments *args)
+{
+	uint64_t address, size;
+	uint32_t width, height, format = 0, bpe, bpr;
+	static uint32_t refused, logged;
+
+	if (selector == kSweetSurfaceWrapClientImage) {
+		const uint8_t *in = (const uint8_t *)args->structureInput;
+		if (in == NULL || args->structureInputSize < 0x1c) {
+			if (refused++ < 6) {
+				IOLog("SWEET SURF: wrap image refused: %u bytes\n", args->structureInputSize);
+			}
+			return kIOReturnBadArgument;
+		}
+		memcpy(&address, in, 8);
+		memcpy(&width, in + 0x08, 4);
+		memcpy(&height, in + 0x0c, 4);
+		memcpy(&format, in + 0x10, 4);
+		memcpy(&bpe, in + 0x14, 4);
+		memcpy(&bpr, in + 0x18, 4);
+		if (width == 0 || height == 0 || bpe == 0 || bpe > 16 || bpr < (uint64_t)width * bpe) {
+			if (refused++ < 6) {
+				IOLog("SWEET SURF: wrap image refused: %ux%u bpe %u bpr %u fmt 0x%x (%u bytes)\n",
+				    width, height, bpe, bpr, format, args->structureInputSize);
+			}
+			return kIOReturnBadArgument;
+		}
+		size = (uint64_t)bpr * height;
+	} else {
+		if (args->scalarInputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		address = args->scalarInput[0];
+		size = args->scalarInput[1];
+		width = (uint32_t)size;
+		height = 1;
+		bpe = 1;
+		bpr = (uint32_t)size;
+	}
+	if (address == 0 || size == 0 || size > (256ull << 20)) {
+		return kIOReturnBadArgument;
+	}
+	uint64_t first = trunc_page_64(address);
+	uint64_t length = round_page_64(address + size) - first;
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(first, length, kIODirectionInOut, fTask);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (md->prepare() != kIOReturnSuccess) {
+		md->release();
+		return kIOReturnVMError;
+	}
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		md->complete();
+		md->release();
+		return kIOReturnNoMemory;
+	}
+	s->memory = md;
+	s->wrapped = true;
+	s->wrapDelta = (uint32_t)(address - first);
+	s->mapCache = kIOMapDefaultCache;
+	s->width = width;
+	s->height = height;
+	s->pixelFormat = format;
+	s->bytesPerElement = (uint16_t)bpe;
+	s->elementWidth = 1;
+	s->elementHeight = 1;
+	s->bytesPerRow = bpr;
+	s->allocSize = (uint32_t)size;
+	s->planeCount = 0;
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return kIOReturnNoResources;
+	}
+	if (logged < 8) {
+		logged++;
+		IOLog("SWEET SURF: wrap %s id %u %ux%u fmt 0x%x bpe %u bpr %u size %llu at +0x%x\n",
+		    selector == kSweetSurfaceWrapClientImage ? "image" : "memory", s->id, width, height, format, bpe, bpr,
+		    size, s->wrapDelta);
+	}
+	IOReturn ret = returnSurface(s, args);  /* takes the creator's user count */
+	s->release();
+	return ret;
+}
