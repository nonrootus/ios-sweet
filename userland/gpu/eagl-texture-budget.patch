+/*
+ * Sweet: a texture made of an IOSurface is a copy in the GPU's pinned pool here, not the surface's
+ * memory as on an iPhone, and CoreAnimation keeps them as if they cost nothing. Past a budget, the
+ * copies bound least recently (not in the last two frames, and to no unit now) give their storage
+ * back; binding one again fills it from its surface, the way a changed surface is filled.
+ */
+#define SWEET_TEXTURE_BUDGET (72u << 20)
+#define SWEET_TEXTURE_KEEP (56u << 20)
+static unsigned sweet_evictions, sweet_refills;
+
+static void
+sweet_texture_resident(struct image *image)
+{
+	if (image->evicted) {
+		sweet_refills++;
+	}
+	image->evicted = false;
+	image->resident = image->target || image->shared ? 0 : (uint32_t)image->width * (uint32_t)image->height * 4u;
+}
+
+static bool
+sweet_texture_bound(const struct eagl *e, GLuint texture)
+{
+	for (unsigned unit = 0; unit < 8; unit++) {
+		if (e->bound[unit] == texture) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+sweet_texture_budget(struct eagl *e)
+{
+	uint64_t resident = 0;
+	unsigned copies = 0, evicted_now = 0;
+
+	for (unsigned i = 0; i < e->image_count; i++) {
+		resident += e->images[i].resident;
+		copies += e->images[i].resident != 0;
+	}
+	if (resident > SWEET_TEXTURE_BUDGET) {
+		GLint bound = 0, unpack = 0;
+
+		glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+		glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack);
+		glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+		while (resident > SWEET_TEXTURE_KEEP) {
+			struct image *oldest = NULL;
+
+			for (unsigned i = 0; i < e->image_count; i++) {
+				struct image *image = &e->images[i];
+
+				if (image->resident == 0 || image->to != GL_TEXTURE_2D || image->last_used + 2 > e->frames ||
+				    sweet_texture_bound(e, image->texture)) {
+					continue;
+				}
+				if (oldest == NULL || image->last_used < oldest->last_used) {
+					oldest = image;
+				}
+			}
+			if (oldest == NULL) {
+				break;
+			}
+			glBindTexture(GL_TEXTURE_2D, oldest->texture);
+			/* No pixels: just storage of one texel, of the kind the texture already has. */
+			if (oldest->xr10) {
+				glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+			} else {
+				glTexImage2D(GL_TEXTURE_2D, 0, (GLint)internal_format(oldest->internal, oldest->format), 1, 1, 0,
+				    oldest->format, oldest->type, NULL);
+			}
+			resident -= oldest->resident;
+			oldest->resident = 0;
+			oldest->evicted = true;
+			evicted_now++;
+		}
+		glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+		glBindBuffer(GL_PIXEL_UNPACK_BUFFER, (GLuint)unpack);
+		sweet_evictions += evicted_now;
+	}
+	if ((evicted_now != 0 && sweet_evictions <= 256) || e->frames % 600 == 0) {
+		say("SWEET BUDGET: frame %u images %u copies %u resident %llu MiB, gave back %u (in all %u, filled again %u)\n",
+		    e->frames, e->image_count, copies, (unsigned long long)(resident >> 20), evicted_now, sweet_evictions,
+		    sweet_refills);
+	}
+}
+
