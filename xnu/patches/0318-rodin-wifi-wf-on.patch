@@ -141,6 +141,9 @@ rodin_pmic_readable(uint8_t sid, uint16_t addr)
 #define MT6363_VCN13_OPEN       0x1d16
 #define MT6363_VBOCK0           0x024c  /* VS2 buck voltage: 0x74 = 1.45 V */
 #define MT6363_VS2_VOTER_SET    0x149b  /* bit 4 = connsys' vote */
+#define MT6368_VANT18_EN        0x1c23  /* bit 0 enable, bit 1 low power (owner's yes 2026-11-21) */
+#define MT6368_VCN33_1_EN       0x1cc0
