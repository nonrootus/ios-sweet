+int sweet_gpu_hfi_memory_retain_mapping(struct sweet_gpu_hfi_memory *, uint64_t *root_pa);
+int sweet_gpu_hfi_memory_release_mapping(struct sweet_gpu_hfi_memory *);
 #ifdef __cplusplus
 }
