+/* Map the bus, ungate its clock if needed (as Linux clk_prepare_enable), and use it only if the
+ * bootloader left its timing set up. */
+static bool
+i2c_bus_ready(struct rodin_i2c *b)
+{
+	if (b->state) {
+		return b->state > 0;
+	}
+	b->base = ml_io_map(b->pa, 0x1000);
+	b->gate = ml_io_map(b->gate_pa, 0x1000);
+	if (!b->base || !b->gate) {
+		b->state = -1;
+		return false;
+	}
+	uint32_t cg = rd32(b->gate, 0xe00), bit = 1u << b->gate_bit;
+	if (cg & bit) {
+		wr32(b->gate, 0xe04, bit);
+	}
+	uint16_t timing = rd16(b->base, I2C_TIMING);
+	printf("RODIN BATTERY: %s clock gate 0x%x%s, TIMING 0x%04x CONTROL 0x%04x LTIMING 0x%04x\n", b->name,
+	    cg, (cg & bit) ? " (was gated: ungated)" : "", timing, rd16(b->base, I2C_CONTROL), rd16(b->base, 0x2c));
+	b->state = timing ? 1 : -1;
+	if (!timing) {
+		printf("RODIN BATTERY: %s not set up by the bootloader: not used\n", b->name);
+	}
+	return timing != 0;
+}
