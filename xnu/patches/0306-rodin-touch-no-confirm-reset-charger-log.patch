+/*
+ * Charger state for the log (MT6375 at 0x34 on I2C5; registers 0x1xx of mt6375-charger.c are bank 1,
+ * i.e. command byte = low byte): read only. Logged with the first battery read and every 5 min.
+ */
+static void
+rodin_charger_log(void)
+{
+	static const char *const stat_names[16] = {
+		"sleep", "vbus ready", "trickle", "pre-charge", "fast charge", "end of charge", "background",
+		"done", "fault", "?9", "?10", "?11", "?12", "?13", "?14", "otg",
+	};
+	uint8_t vid = 0, top1 = 0, aicr = 0, mivr = 0, vchg = 0, ichg = 0, wdt = 0, stat = 0;
+	if (!i2c_bus_ready(&i2c_chg)) {
+		return;
+	}
+	int e = i2c_wrrd(&i2c_chg, 0x34, 0x00, &vid, 1);
+	e = e ? e : i2c_wrrd(&i2c_chg, 0x34, 0x20, &top1, 1);
+	e = e ? e : i2c_wrrd(&i2c_chg, 0x34, 0x22, &aicr, 1);
+	e = e ? e : i2c_wrrd(&i2c_chg, 0x34, 0x23, &mivr, 1);
+	e = e ? e : i2c_wrrd(&i2c_chg, 0x34, 0x25, &vchg, 1);
+	e = e ? e : i2c_wrrd(&i2c_chg, 0x34, 0x26, &ichg, 1);
+	e = e ? e : i2c_wrrd(&i2c_chg, 0x34, 0x2a, &wdt, 1);
+	e = e ? e : i2c_wrrd(&i2c_chg, 0x34, 0x34, &stat, 1);
+	if (e) {
+		printf("RODIN CHARGER: MT6375 read error %d\n", e);
+		return;
+	}
+	unsigned a = aicr & 0x7fu, c = ichg & 0x3fu;
+	printf("RODIN CHARGER: MT6375 vid 0x%02x, %s, CHG_EN %u BUCK %u HZ %u power-good %u, input limit %u mA%s, "
+	    "charge %u mA, CV %u mV, MIVR %u mV, charger WDT %s\n", vid, stat_names[stat & 15u], top1 & 1u,
+	    (top1 >> 1) & 1u, (top1 >> 3) & 1u, (top1 >> 7) & 1u, a >= 2 ? 100 + (a - 2) * 25 : 100,
+	    (aicr & 0x80u) ? " (ILIM pin)" : "", c >= 6 ? 300 + (c - 6) * 50 : 300, 3900 + (vchg & 0x7fu) * 10,
+	    3900 + (mivr & 0x7fu) * 100, (wdt & 8u) ? "on" : "off");
+}
