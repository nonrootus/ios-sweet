+/*
+ * Before this boot's first flush: copy the previous boot's log area (if it
+ * holds a SWEETLOG header) to the same-sized area right before it, so a
+ * boot that ended in a spontaneous reboot can still be read afterwards
+ * (Poco X7 Pro). Both areas are far behind the HFS image.
+ */
+static void
+sweet_log_keep_previous(uint64_t base)
+{
+	uint64_t prev = base - SWEET_LOG_BLOCKS;
+	const void *bounce = (const void *)(su.dma + DMA_BOUNCE);
+	int error;
+	bool valid;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_blocks(base, 1);
+	valid = !error && memcmp(bounce, "SWEETLOG", 8) == 0;
+	for (uint32_t done = 0; valid && !error && done < SWEET_LOG_BLOCKS;) {
+		uint32_t n = MIN(SWEET_LOG_BLOCKS - done, BOUNCE_SIZE / UFS_BLOCK);
+		error = ufs_read_blocks(base + done, n);
+		if (!error) {
+			error = ufs_write_blocks(prev + done, n);
+		}
+		done += n;
+	}
+	if (valid && !error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	printf("SWEET LOG: previous boot's log %s (block 0x%llx, error %d)\n",
+	    !valid ? "not found" : error ? "copy FAILED" : "kept", prev, error);
+}
