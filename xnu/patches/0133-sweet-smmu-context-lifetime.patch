 struct sweet_gpu_hfi_memory *sweet_gpu_hfi_memory_create(uint32_t iova);
 int sweet_gpu_hfi_memory_info(const struct sweet_gpu_hfi_memory *,
     uint64_t *root_pa, uint32_t *iova);
