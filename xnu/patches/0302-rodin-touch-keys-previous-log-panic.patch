+/* One byte, as Linux pmif_spmi_write_cmd: IDLE, WDATA, ACC with the write bit, IDLE. */
+static int
+rodin_pmic_write(uint8_t sid, uint16_t addr, uint8_t val)
+{
+	uint32_t sta = 0;
+	unsigned i;
+
+	if (!pmif || !rodin_pmic_writable(sid, addr)) {
+		return EPERM;
+	}
+	for (i = 0; i < 1000; i++) {
+		sta = rd32(pmif, PMIF_SWINF2_STA);
+		if (PMIF_FSM(sta) == PMIF_FSM_IDLE) {
+			break;
+		}
+		delay(10);
+	}
+	pmif_last_sta = sta;
+	if (PMIF_FSM(sta) != PMIF_FSM_IDLE) {
+		return EBUSY;
+	}
+	wr32(pmif, PMIF_SWINF2_WDATA, val);
+	wr32(pmif, PMIF_SWINF2_ACC, (PMIF_CMD_EXT_REG_LONG << 30) | PMIF_CMD_WRITE | ((uint32_t)sid << 24) | addr);
+	for (i = 0; i < 1000; i++) {
+		sta = rd32(pmif, PMIF_SWINF2_STA);
+		if (PMIF_FSM(sta) == PMIF_FSM_IDLE) {
+			break;
+		}
+		delay(10);
+	}
+	pmif_last_sta = sta;
+	if (PMIF_FSM(sta) != PMIF_FSM_IDLE) {
+		return ETIMEDOUT;
+	}
+	return (sta & PMIF_STA_ERR) ? EIO : 0;
+}
