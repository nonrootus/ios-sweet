 /* Fill a texture, which is bound, from its IOSurface, unless it is the surface. */
+/* Keep the wrapped surface's A,B,G,R order when copying a draw back. */
+static void
+abgr_readback(struct eagl *e, struct image *image)
+{
+	IOSurfaceRef surface = image->surface;
+	uint8_t *pixels = b3a8_scratch(e, image);
+	if (pixels == NULL || glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+		return;
+	}
+
+	GLint saved[5];
+	b3a8_transfer_state(true, saved, false);
+	glGetError();
+	glReadPixels(0, 0, image->width, image->height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	GLenum error = glGetError();
+	b3a8_transfer_state(true, saved, true);
+	if (error != GL_NO_ERROR || IOSurfaceLock(surface, 0, NULL) != 0) {
+		return;
+	}
+
+	uint8_t *base = IOSurfaceGetBaseAddress(surface);
+	size_t stride = IOSurfaceGetBytesPerRow(surface);
+	size_t width = (size_t)image->width, height = (size_t)image->height;
+	if (base != NULL && sweet_b3a8_plane_fits(0, stride, width * 4, height, IOSurfaceGetAllocSize(surface))) {
+		for (size_t y = 0; y < height; y++) {
+			const uint8_t *rgba = pixels + y * width * 4;
+			uint8_t *abgr = base + (image->invert ? height - 1 - y : y) * stride;
+			for (size_t x = 0; x < width; x++, rgba += 4, abgr += 4) {
+				abgr[0] = rgba[3];
+				abgr[1] = rgba[2];
+				abgr[2] = rgba[1];
+				abgr[3] = rgba[0];
+			}
+		}
+	}
+	IOSurfaceUnlock(surface, 0, NULL);
+}
