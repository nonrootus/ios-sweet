+		}
+		if (buf[0] == 0) {
+			continue;
+		}
+		if (!gdx_checksum_ok(buf, GDX_HEAD)) {
+			if (errors++ % 1000 == 0) {
+				printf("RODIN TOUCH: head checksum error %02x %02x %02x %02x\n", buf[0], buf[1], buf[2], buf[3]);
