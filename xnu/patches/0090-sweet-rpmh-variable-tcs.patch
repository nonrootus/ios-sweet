+static int
+rh_send(uint32_t address, unsigned mv)
+{
+    /* Preserve PMIC5 LDO sequence: voltage, HPM, then enable. */
+    const uint32_t offsets[3] = {0, 8, 4};
+    const uint32_t values[3] = {mv, 7, 1};
+    return rh_send_commands(address, offsets, values, 3);
