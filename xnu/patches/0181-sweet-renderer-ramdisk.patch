+#if defined(ARM64_BOARD_CONFIG_SWEET) && DEVFS && CONFIG_UNION_MOUNTS
+static void
+sweet_mount_renderer_disk(void)
+{
+	DTEntry memory_map;
+	unsigned int size;
+	const void *property;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &memory_map) != kSuccess ||
+	    SecureDTGetProperty(memory_map, "SweetRendererDisk", &property, &size) != kSuccess) {
+		return;
+	}
+
+	uint64_t disk[2];
+	uint64_t firmware[2];
+	if (size != sizeof(disk)) {
+		return;
+	}
+	memcpy(disk, property, sizeof(disk));
+	if (SecureDTGetProperty(memory_map, "RAMDisk", &property, &size) != kSuccess ||
+	    size != sizeof(firmware)) {
+		return;
+	}
+	memcpy(firmware, property, sizeof(firmware));
+	const boot_args *args = PE_state.bootArgs;
+	if (args == NULL || disk[0] < args->physBase || disk[0] >= args->topOfKernelData ||
+	    disk[1] < (1u << 20) || disk[1] > (4u << 20) ||
+	    ((disk[0] | disk[1]) & PAGE_MASK) != 0 || disk[1] > args->topOfKernelData - disk[0] ||
+	    firmware[0] >= disk[0] || firmware[1] != disk[0] - firmware[0]) {
+		printf("SWEET CA: invalid renderer RAM disk range\n");
+		return;
+	}
+
+	extern dev_t mdevlookup(int devid);
+	extern dev_t mdevadd(int devid, uint64_t base, unsigned int size, int phys);
+	if (mdevlookup(0) == (dev_t)-1 || mdevlookup(1) != (dev_t)-1 ||
+	    mdevadd(1, ml_static_ptovirt(disk[0]) >> 12, (unsigned int)(disk[1] >> 12), 0) == (dev_t)-1) {
+		printf("SWEET CA: could not register renderer RAM disk\n");
+		return;
+	}
+
+	/* Only the replacement library is present. Other files resolve below it. */
+	int error = kernel_mount("hfs", NULLVP, NULLVP, "/sweet/lib", "/dev/md1", 0,
+	    MNT_RDONLY | MNT_UNION | MNT_NOSUID, KERNEL_MOUNT_SWEET_DISK, vfs_context_kernel());
+	printf("SWEET CA: renderer RAM disk mount rc=%d\n", error);
+}
+#endif
