+                uint32_t ctrl = *(volatile uint32_t *)(cc + 0x06cu);
+                __asm__ volatile ("dmb oshld" ::: "memory");
+                uint32_t status = *(volatile uint32_t *)(cc + 0x540u);
+                __asm__ volatile ("dmb oshld" ::: "memory");
+                printf("SWEET GPU: CX GDSC ctrl=0x%08x status=0x%08x; no GPUCC writes\n", ctrl, status);
+            }
+        }
+    }
     int arc_probe = 0;
