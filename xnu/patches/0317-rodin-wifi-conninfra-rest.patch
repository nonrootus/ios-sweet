+static struct {
+	uint32_t pa;
+	vm_offset_t va;
+} rodin_conn_pages[48];
+
+/* One permanent 4 KiB mapping per page of the connectivity block (io_map entries cannot be freed). */
+static vm_offset_t
+rodin_conn_va(uint32_t pa)
+{
+	uint32_t page = pa & ~0xfffu;
+	uint32_t i = 0;
+	for (; i < sizeof(rodin_conn_pages) / sizeof(rodin_conn_pages[0]) && rodin_conn_pages[i].va; i++) {
+		if (rodin_conn_pages[i].pa == page) {
+			return rodin_conn_pages[i].va + (pa & 0xfffu);
+		}
+	}
+	if (i == sizeof(rodin_conn_pages) / sizeof(rodin_conn_pages[0])) {
+		return 0;
+	}
+	vm_offset_t va = ml_io_map(page, 0x1000);
+	if (!va) {
+		return 0;
+	}
+	rodin_conn_pages[i].pa = page;
+	rodin_conn_pages[i].va = va;
+	return va + (pa & 0xfffu);
+}
+
+static int
+rodin_adie_spi_write(vm_offset_t spi, uint32_t addr, uint32_t val)
+{
+	/* SYS_SPI_TOP write: busy bit 5 of STA, ADDR +0x50 (write format 0xa000), WDAT +0x54 */
+	if (!rodin_poll_bit(spi, 0x00, 5, 0, 100, 50)) {
+		return EBUSY;
+	}
+	wr32(spi, 0x50, 0xa000u | addr);
+	wr32(spi, 0x54, val);
+	delay(1);
+	return rodin_poll_bit(spi, 0x00, 5, 0, 100, 50) ? 0 : ETIMEDOUT;
+}
+
+static bool
+rodin_conn_sema_get(vm_offset_t sema, uint32_t index)
+{
+	for (int i = 0; i < 1000; i++) {
+		if (rd32(sema, 0x2000 + index * 4) & 1u) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+rodin_conn_sema_put(vm_offset_t sema, uint32_t index)
+{
+	wr32(sema, 0x2200 + index * 4, 1);
+}
+
+/* Runs a table; A-die SPI writes take the RF SPI semaphore themselves unless the caller holds it. */
+static uint32_t
+rodin_conn_run(const char *name, const struct rodin_conn_op *t, uint32_t n, vm_offset_t spi, vm_offset_t sema,
+    bool held)
+{
+	uint32_t bad = 0, spis = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		const struct rodin_conn_op *o = &t[i];
+		if (o->op == 6) {
+			delay(o->v);
+			continue;
+		}
+		if (o->op == 7) {
+			bool got = held || rodin_conn_sema_get(sema, CONN_SEMA_RFSPI);
+			int e = got ? rodin_adie_spi_write(spi, o->pa, o->v) : EBUSY;
+			if (got && !held) {
+				rodin_conn_sema_put(sema, CONN_SEMA_RFSPI);
+			}
+			spis++;
+			if (e) {
+				bad++;
+				printf("RODIN WIFI: %s #%u: A-die SPI write 0x%03x = 0x%08x failed %d\n", name, i, o->pa, o->v, e);
+			}
+			continue;
+		}
+		vm_offset_t va = rodin_conn_va(o->pa);
+		if (!va) {
+			printf("RODIN WIFI: %s #%u: no mapping for 0x%08x\n", name, i, o->pa);
+			return bad + 1;
+		}
+		volatile uint32_t *r = (volatile uint32_t *)va;
+		switch (o->op) {
+		case 1: *r = o->v; break;
+		case 2: *r = (*r & ~o->m) | (o->v & o->m); break;
+		case 3: *r = *r | o->v; break;
+		case 4: *r = *r & ~o->v; break;
+		case 5: {
+			uint32_t k = 0;
+			for (; k < o->v && ((*r >> o->a) & 1u) != o->b; k++) {
+				delay(o->m);
+			}
+			if (((*r >> o->a) & 1u) != o->b) {
+				bad++;
+				printf("RODIN WIFI: %s #%u: 0x%08x bit %u not %u (0x%08x)\n", name, i, o->pa, o->a, o->b, *r);
+			}
+			break;
+		}
+		default: break;
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	printf("RODIN WIFI: %s: %u ops (%u A-die SPI), %u failed\n", name, n, spis, bad);
+	return bad;
+}
+
+#define CONN_TABLE(t)   (t), (uint32_t)(sizeof(t) / sizeof((t)[0]))
+
+/* A-die efuse: read the 4 words of block addr into the sysram software CRs at sw. */
+static bool
+rodin_adie_efuse(vm_offset_t spi, uint32_t addr, vm_offset_t sram, uint32_t sw, uint32_t *w)
+{
+	uint32_t c = 0;
+	(void)rodin_adie_spi_read(spi, 0x108, &c);
+	(void)rodin_adie_spi_write(spi, 0x108, c & ~0x40000000u);
+	(void)rodin_adie_spi_read(spi, 0x108, &c);
+	c = (c & ~0x43ff00c0u) | 0x40000000u | ((addr << 16) & 0x3ff0000u);
+	(void)rodin_adie_spi_write(spi, 0x108, c);
+	for (int i = 0; i < 70; i++) {
+		(void)rodin_adie_spi_read(spi, 0x108, &c);
+		if (!(c & (1u << 30))) {
+			break;
+		}
+		delay(30);
+	}
+	(void)rodin_adie_spi_read(spi, 0x108, &c);
+	if (!(c & (1u << 29))) {
+		return false;
+	}
+	for (uint32_t k = 0; k < 4; k++) {
+		(void)rodin_adie_spi_read(spi, 0x130 + 4 * k, &w[k]);
+		wr32(sram, sw + 4 * k, w[k]);
+	}
+	return true;
+}
+
+/* bits [vo, vo+size) of value into bits [ro, ro+size) of A-die register addr */
+static void
+rodin_adie_bits(vm_offset_t spi, uint32_t addr, uint32_t value, uint32_t ro, uint32_t vo, uint32_t size)
+{
+	uint32_t m = ((1u << size) - 1u) << ro, d = 0;
+	if (rodin_adie_spi_read(spi, addr, &d) == 0) {
+		(void)rodin_adie_spi_write(spi, addr, (d & ~m) | (((value >> vo) << ro) & m));
+	}
+}
+
+static void
+rodin_wifi_conninfra_rest(vm_offset_t spi, vm_offset_t sema, vm_offset_t sram, vm_offset_t wt)
+{
+	uint32_t bad = 0, e0[4] = { 0 }, e1[4] = { 0 };
+	if (!rodin_conn_sema_get(sema, CONN_SEMA_RFSPI)) {
+		printf("RODIN WIFI: step 2c: RF SPI semaphore not taken\n");
+		return;
+	}
+	bad += rodin_conn_run("A-die part 1", CONN_TABLE(rodin_conn_adie_part1), spi, sema, true);
+	bool v0 = rodin_adie_efuse(spi, 0x0, sram, 0x3804, e0);
+	if (v0 && (e0[1] & (1u << 7))) {
+		rodin_adie_bits(spi, 0x34, e0[1], 12, 3, 4);       /* RG_TOP_THADC_BG */
+		rodin_adie_bits(spi, 0x38, e0[1], 23, 0, 3);       /* RG_TOP_THADC */
+	}
+	if (v0 && (e0[1] & (1u << 15))) {
+		rodin_adie_bits(spi, 0x38, e0[1], 26, 13, 2);
+	}
+	bool v1 = rodin_adie_efuse(spi, 0x1d0, sram, 0x3848, e1);
+	printf("RODIN WIFI: A-die efuse %s %08x %08x %08x %08x, %s %08x %08x %08x %08x\n", v0 ? "valid" : "INVALID",
+	    e0[0], e0[1], e0[2], e0[3], v1 ? "valid" : "INVALID", e1[0], e1[1], e1[2], e1[3]);
+	bad += rodin_conn_run("A-die part 2", CONN_TABLE(rodin_conn_adie_part2), spi, sema, true);
+	rodin_conn_sema_put(sema, CONN_SEMA_RFSPI);
+	rodin_mask32(gpio, 0x480, 0x100000, 0x700000);          /* A-die to conn mode (GPIO 197 mode 1) */
+	bad += rodin_conn_run("sleep mode 3", CONN_TABLE(rodin_conn_sleep3), spi, sema, false);
+	bad += rodin_conn_run("AFE WBG calibration", CONN_TABLE(rodin_conn_afe_cal), spi, sema, false);
+	bad += rodin_conn_run("PLL", CONN_TABLE(rodin_conn_pll), spi, sema, false);
+	/* radio status in the common sysram: Wi-Fi (bit 3), under semaphore 23 */
+	if (rodin_conn_sema_get(sema, 23)) {
+		wr32(sram, 0x3834, rd32(sram, 0x3834) | (1u << 3));
+		rodin_conn_sema_put(sema, 23);
+	} else {
+		bad++;
+		printf("RODIN WIFI: common sysram semaphore not taken\n");
+	}
+	/* A-die clock buffer for Wi-Fi on */
+	wr32(wt, 0x120, rd32(wt, 0x120) | 1u);
+	(void)rodin_poll_bit(wt, 0x120, 1, 0, 100, 5);
+	if (rodin_conn_sema_get(sema, CONN_SEMA_RFSPI)) {
+		(void)rodin_adie_spi_write(spi, 0xb04, 0xfe000000);
+		(void)rodin_adie_spi_write(spi, 0xb08, 0xe0000000);
+		rodin_conn_sema_put(sema, CONN_SEMA_RFSPI);
+	}
+	wr32(wt, 0x120, rd32(wt, 0x120) & ~1u);
+	(void)rodin_poll_bit(wt, 0x120, 1, 0, 100, 5);
+	/* low-power setting */
+	vm_offset_t rc = ml_io_map(0x1c00d000, 0x1000);
+	bool rcmode = rc && (rd32(rc, 0x004) & 1u);
+	bad += rodin_conn_run("low power (pre)", CONN_TABLE(rodin_conn_lp_pre), spi, sema, false);
+	if (rcmode) {
+		bad += rodin_conn_run("low power (RC mode)", CONN_TABLE(rodin_conn_lp_rc), spi, sema, false);
+	} else {
+		bad += rodin_conn_run("low power (no RC mode)", CONN_TABLE(rodin_conn_lp_norc), spi, sema, false);
+	}
+	bad += rodin_conn_run("low power", CONN_TABLE(rodin_conn_lp_post), spi, sema, false);
+	for (uint32_t i = 0; i < 1024; i++) {
+		wr32(sram, 4 * i, rodin_conn_cmdbt[i]);
+	}
+	bad += rodin_conn_run("low power (end)", CONN_TABLE(rodin_conn_lp_end), spi, sema, false);
+	printf("RODIN WIFI: conninfra power-on done (RC mode %d), %u failures: %s\n", rcmode, bad,
+	    bad ? "SEE ABOVE" : "CONNINFRA UP");
+}
