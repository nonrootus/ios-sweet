+/* ---- Battery: TI bq28z610 fuel gauge on I2C10, read only ------------------------------------ */
+/*
+ * rodin_battery_read() is called by SweetBattery (boot-arg rodinbattery=1) every 30 s. The gauge
+ * sits at 0x55 on i2c@11280000 (I2C10, MediaTek "mt6989-i2c" v2 registers). The bus is used as the
+ * bootloader left it: if its timing register is still 0 nothing is sent. Each read is one
+ * write-then-read transaction (command byte, repeated start, 2 bytes) in FIFO mode, polled, as
+ * Linux i2c-mt65xx.c with mediatek,fifo-use-polling. Only the gauge's standard read commands are
+ * used; nothing is written to the gauge or the charger.
+ */
+#define I2C10_PA                0x11280000u
+#define IMPC_PA                 0x11284000u     /* imp_iic_wrap_c: I2C10 gate, STA 0xE00 / CLR 0xE04 bit 0 */
+#define I2C_DATA_PORT           0x00u
+#define I2C_INTR_MASK           0x08u
+#define I2C_INTR_STAT           0x0cu
+#define I2C_CONTROL             0x10u
+#define I2C_TRANSFER_LEN        0x14u
+#define I2C_TRANSAC_LEN         0x18u
+#define I2C_TIMING              0x20u
+#define I2C_START               0x24u
+#define I2C_FIFO_ADDR_CLR       0x38u
+#define I2C_TRANSFER_LEN_AUX    0x44u
+#define I2C_SLAVE_ADDR1         0x94u
+#define I2C_CTL_RS              (1u << 1)
+#define I2C_CTL_DMA_EN          (1u << 2)
+#define I2C_CTL_CLK_EXT_EN      (1u << 3)
+#define I2C_CTL_DIR_CHANGE      (1u << 4)
+#define I2C_CTL_DMAACK_EN       (1u << 8)
+#define I2C_CTL_ASYNC           (1u << 9)
+#define I2C_ST_COMP             (1u << 0)
+#define I2C_ST_ACKERR           (1u << 1)
+#define I2C_ST_HS_NACKERR       (1u << 2)
+#define I2C_ST_ARB_LOST         (1u << 3)
+#define I2C_ST_RS_TRANSFER      (1u << 4)
+#define I2C_ST_CONFERR          (1u << 9)
+#define I2C_START_TRANSAC       (1u << 0)
+#define I2C_START_RS_MUL_TRIG   (1u << 14)
+#define BQ28Z610_ADDR           0x55u
+
+static vm_offset_t i2c10, impc;
+static bool batt_ready, batt_off;
+static unsigned batt_reads, batt_errors;
+
+static uint16_t
+rd16(vm_offset_t base, uint32_t off)
+{
+	uint16_t v = *(volatile uint16_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr16(vm_offset_t base, uint32_t off, uint16_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint16_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Write one command byte, repeated start, read n (<= 16) bytes. */
+static int
+i2c10_wrrd(uint8_t addr7, uint8_t cmd, uint8_t *out, uint32_t n)
+{
+	uint16_t st = 0;
+	unsigned i;
+
+	if (n == 0 || n > 16) {
+		return EINVAL;
+	}
+	uint16_t ctl = rd16(i2c10, I2C_CONTROL) &
+	    (uint16_t)~(I2C_CTL_DIR_CHANGE | I2C_CTL_RS | I2C_CTL_DMA_EN | I2C_CTL_DMAACK_EN | I2C_CTL_ASYNC);
+	wr16(i2c10, I2C_CONTROL, (uint16_t)(ctl | I2C_CTL_CLK_EXT_EN | I2C_CTL_DIR_CHANGE | I2C_CTL_RS));
+	wr16(i2c10, I2C_SLAVE_ADDR1, (uint16_t)(addr7 << 1));
+	wr16(i2c10, I2C_INTR_STAT, I2C_ST_RS_TRANSFER | I2C_ST_CONFERR | I2C_ST_HS_NACKERR | I2C_ST_ACKERR |
+	    I2C_ST_ARB_LOST | I2C_ST_COMP);
+	wr16(i2c10, I2C_FIFO_ADDR_CLR, 1);
+	wr16(i2c10, I2C_INTR_MASK, 0);
+	wr16(i2c10, I2C_TRANSFER_LEN, 1);
+	wr16(i2c10, I2C_TRANSFER_LEN_AUX, (uint16_t)n);
+	wr16(i2c10, I2C_TRANSAC_LEN, 2);
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint8_t *)(i2c10 + I2C_DATA_PORT) = cmd;
+	wr16(i2c10, I2C_START, I2C_START_TRANSAC | I2C_START_RS_MUL_TRIG);
+	for (i = 0; i < 4000; i++) {    /* 20 ms */
+		st = rd16(i2c10, I2C_INTR_STAT);
+		if (st & (I2C_ST_COMP | I2C_ST_ACKERR | I2C_ST_HS_NACKERR | I2C_ST_ARB_LOST)) {
+			break;
+		}
+		delay(5);
+	}
+	wr16(i2c10, I2C_INTR_STAT, st);
+	if (!(st & (I2C_ST_COMP | I2C_ST_ACKERR | I2C_ST_HS_NACKERR | I2C_ST_ARB_LOST))) {
+		wr16(i2c10, I2C_FIFO_ADDR_CLR, 1);
+		return ETIMEDOUT;
+	}
+	if (st & (I2C_ST_ACKERR | I2C_ST_HS_NACKERR | I2C_ST_ARB_LOST)) {
+		wr16(i2c10, I2C_FIFO_ADDR_CLR, 1);
+		return ENXIO;
+	}
+	for (i = 0; i < n; i++) {
+		out[i] = *(volatile uint8_t *)(i2c10 + I2C_DATA_PORT);
+	}
+	return 0;
+}
+
+static int
+bq_word(uint8_t cmd, uint16_t *v)
+{
+	uint8_t b[2];
+	int e = i2c10_wrrd(BQ28Z610_ADDR, cmd, b, 2);
+	*v = (uint16_t)(b[0] | (b[1] << 8));
+	return e;
+}
+
+int rodin_battery_read(unsigned *percent, unsigned *mv, int *ma, unsigned *decikelvin);
+
+int
+rodin_battery_read(unsigned *percent, unsigned *mv, int *ma, unsigned *decikelvin)
+{
+	if (batt_off) {
+		return ENODEV;
+	}
+	if (!batt_ready) {
+		i2c10 = ml_io_map(I2C10_PA, 0x1000);
+		impc = ml_io_map(IMPC_PA, 0x1000);
+		if (!i2c10 || !impc) {
+			batt_off = true;
+			return ENOMEM;
+		}
+		uint32_t cg = rd32(impc, 0xe00);
+		if (cg & 1u) {
+			wr32(impc, 0xe04, 1u);  /* ungate I2C10, as Linux clk_prepare_enable would */
+		}
+		uint16_t timing = rd16(i2c10, I2C_TIMING);
+		printf("RODIN BATTERY: I2C10 clock gate 0x%x%s, TIMING 0x%04x CONTROL 0x%04x LTIMING 0x%04x\n",
+		    cg, (cg & 1u) ? " (was gated: ungated)" : "", timing, rd16(i2c10, I2C_CONTROL), rd16(i2c10, 0x2c));
+		if (timing == 0) {
+			printf("RODIN BATTERY: I2C10 not set up by the bootloader; battery stays static\n");
+			batt_off = true;
+			return ENODEV;
+		}
+		batt_ready = true;
+	}
+	uint16_t soc = 0, volt = 0, curr = 0, temp = 0;
+	int e = bq_word(0x2c, &soc);            /* RelativeStateOfCharge, % */
+	if (!e) {
+		e = bq_word(0x08, &volt);       /* Voltage, mV */
+	}
+	if (!e) {
+		e = bq_word(0x0c, &curr);       /* Current, mA, > 0 charging */
+	}
+	if (!e) {
+		e = bq_word(0x06, &temp);       /* Temperature, 0.1 K */
+	}
+	soc &= 0xffu;
+	if (e || soc > 100 || volt < 2800 || volt > 4700 || temp < 2330 || temp > 3530) {
+		if (batt_errors++ < 10) {
+			printf("RODIN BATTERY: read err %d soc %u volt %u curr %d temp %u\n", e, soc, volt,
+			    (int)(int16_t)curr, temp);
+		}
+		if (batt_errors >= 10 && batt_reads == 0) {
+			printf("RODIN BATTERY: gauge not answering; battery stays static\n");
+			batt_off = true;
+		}
+		return e ? e : EINVAL;
+	}
+	*percent = soc;
+	*mv = volt;
+	*ma = (int)(int16_t)curr;
+	*decikelvin = temp;
+	if (batt_reads++ % 10 == 0) {
+		int c10 = (int)temp - 2731, a10 = c10 < 0 ? -c10 : c10;
+		printf("RODIN BATTERY: %u%%, %u mV, %d mA, %s%d.%d C\n", soc, volt, (int)(int16_t)curr,
+		    c10 < 0 ? "-" : "", a10 / 10, a10 % 10);
+	}
+	return 0;
+}
