+/*
+ * ---- Wi-Fi step 1: a read-only look at the connectivity block (rodinwifidiag=1) ----
+ * MT6899's Wi-Fi is its own connectivity block (DT /soc/wifi@18000000, MediaTek gen4m chip SOC7_0,
+ * CFG_WLAN_LK_FWDL_SUPPORT: LK's app_load_connsys loads the firmware from partition connsys_wifi
+ * into the connsys EMI at every boot). Nothing is written. Printed: the PMIC supplies above, the
+ * SPM CONN power domain (scpsys mt6899: PWR_CON at +0xe04, status in its ack bits), the AP<->CONN
+ * bus protection (infra ifrbus ao 0x1002c000: INFRASYS0 en/sta 0x000/0x00c bits 25, 26, CONNSYS0
+ * 0x1c0/0x1cc bits 0, 1), and which 64 KiB blocks of the connsys EMI (0x8de00000, 12 MiB) and of the
+ * Wi-Fi DMA pool (0x8eb00000, 20 MiB) hold data. The block's own registers at 0x18000000 are not
+ * read: with the block off an access there may hang the bus.
+ */
+static void
+rodin_wifi_scan_ram(const char *what, uint64_t pa, uint32_t size)
+{
+	vm_offset_t va = ml_io_map((vm_offset_t)pa, size);
+	if (!va) {
+		printf("RODIN WIFI: %s: no mapping\n", what);
+		return;
+	}
+	uint32_t used = 0, shown = 0;
+	for (uint32_t o = 0; o < size; o += 0x10000) {
+		const volatile uint32_t *w = (const volatile uint32_t *)(va + o);
+		uint32_t a = w[0], b = w[1], c = w[2], d = w[3];
+		bool any = (a | b | c | d) != 0;
+		for (uint32_t k = 0x1000; k < 0x10000 && !any; k += 0x1000) {
+			const volatile uint32_t *q = (const volatile uint32_t *)(va + o + k);
+			any = (q[0] | q[1] | q[2] | q[3]) != 0;
+		}
+		if (any) {
+			used++;
+			if (shown++ < 48) {
+				printf("RODIN WIFI: %s +0x%06x: %08x %08x %08x %08x\n", what, o, a, b, c, d);
+			}
+		}
+	}
+	printf("RODIN WIFI: %s 0x%llx + 0x%x: %u of %u 64 KiB blocks hold data\n", what, pa, size, used,
+	    size / 0x10000);
+}
+
+static void
+rodin_wifi_diag(void)
+{
+	for (uint32_t i = 0; i < sizeof(rodin_wifi_pmic) / sizeof(rodin_wifi_pmic[0]); i++) {
+		uint8_t v = 0;
+		int e = rodin_pmic_read(rodin_wifi_pmic[i].sid, rodin_wifi_pmic[i].addr, &v);
+		printf("RODIN WIFI: PMIC %s (sid %u 0x%04x) = 0x%02x%s\n", rodin_wifi_pmic[i].name,
+		    rodin_wifi_pmic[i].sid, rodin_wifi_pmic[i].addr, v, e ? " (read error)" : "");
+	}
+	vm_offset_t spm = ml_io_map(0x1c001000, 0x1000), ifr = ml_io_map(0x1002c000, 0x1000);
+	if (spm && ifr) {
+		printf("RODIN WIFI: SPM CONN_PWR_CON 0x%08x; bus protection INFRASYS0 en 0x%08x sta 0x%08x, "
+		    "CONNSYS0 en 0x%08x sta 0x%08x\n", rd32(spm, 0xe04), rd32(ifr, 0x000), rd32(ifr, 0x00c),
+		    rd32(ifr, 0x1c0), rd32(ifr, 0x1cc));
+	}
+	rodin_wifi_scan_ram("connsys EMI", 0x8de00000ull, 0xc00000);
+	rodin_wifi_scan_ram("Wi-Fi DMA pool", 0x8eb00000ull, 0x1400000);
+}
