+static void
+rodin_wifi_dbg_flags(const char *who, vm_offset_t base)
+{
+	for (uint32_t f = 0x100; f <= 0x131; f += 8) {
+		uint32_t v[8];
+		for (uint32_t k = 0; k < 8; k++) {
+			wr32(base, 0x124, f + k);
+			delay(1);
+			v[k] = rd32(base, 0x128);
+		}
+		printf("RODIN WIFI: %s WPDMA dbg %03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", who, f, v[0], v[1], v[2],
+		    v[3], v[4], v[5], v[6], v[7]);
+	}
+}
