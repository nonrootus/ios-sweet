@@ -0,0 +1,9 @@
+#ifndef SWEET_GPU_HFI_TABLE_H
+#define SWEET_GPU_HFI_TABLE_H
+#include <stddef.h>
+#include <stdint.h>
+#define SWEET_HFI_V1_BYTES 16608u
+/* Downstream four-header legacy layout. Caller owns aligned GPU-visible memory,
+ * cache maintenance, mapping, synchronization and hardware protocol. */
+int sweet_gpu_hfi_table_init(void *, size_t, uint32_t gmu_iova);
+#endif
