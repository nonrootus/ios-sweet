+/* A surface of the caller's own memory, wired for as long as the surface lives (as wrapClient). */
+IOReturn
+IOSurfaceRootUserClient::wrapTaskMemory(SweetSurface *s, uint64_t address, uint64_t size)
+{
+	if (address == 0 || size == 0 || size > (256ull << 20)) {
+		return kIOReturnBadArgument;
+	}
+	uint64_t first = trunc_page_64(address);
+	uint64_t length = round_page_64(address + size) - first;
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(first, length, kIODirectionInOut, fTask);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (md->prepare() != kIOReturnSuccess) {
+		md->release();
+		return kIOReturnVMError;
+	}
+	s->memory = md;
+	s->wrapped = true;
+	s->wrapDelta = (uint32_t)(address - first);
+	s->mapCache = kIOMapDefaultCache;
+	s->allocSize = (uint32_t)size;
+	return sweet_surface_publish(s) ? kIOReturnSuccess : kIOReturnNoResources;
+}
