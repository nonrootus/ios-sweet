 	return error;
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static int renameat_internal(vfs_context_t ctx, int fromfd, user_addr_t from,
+    int tofd, user_addr_t to, int segflg, u_int uflags);
+int sweet_kernel_rename(const char *from, const char *to);
+
+/* bsd_init: a rename by kernel paths that never replaces the destination. */
+int
+sweet_kernel_rename(const char *from, const char *to)
+{
+	return renameat_internal(vfs_context_kernel(), AT_FDCWD, CAST_USER_ADDR_T(from),
+	           AT_FDCWD, CAST_USER_ADDR_T(to), UIO_SYSSPACE, VFS_RENAME_EXCL);
+}
+#endif
