--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -27,7 +27,10 @@
 #include <kern/startup.h>
 #include <libkern/amfi/amfi.h>
 #include <mach/kern_return.h>
+#include <pexpert/pexpert.h>
 #include <sys/codesign.h>
+#include <sys/errno.h>
+#include <sys/param.h>
 #include <sys/mount.h>
 #include <sys/priv.h>
 #include <sys/proc.h>
@@ -367,6 +370,64 @@
 
 static mac_policy_handle_t sweet_amfi_mac_handle;
 
+/* 20H392 dyld's AMFI policy query passes two 64-bit words:
+ * input flags and a user pointer to the output flags. Serve only the signed
+ * window server from the GPU test root, launched by launchd. */
+static int
+sweet_renderer_dyld_policy(proc_t p, int call, user_addr_t arg)
+{
+	static const unsigned char expected[CS_CDHASH_LEN] = {
+		0x89, 0xe6, 0x32, 0x85, 0x41, 0xc2, 0xe3, 0x75, 0x22, 0xd9,
+		0x0f, 0xa4, 0xa6, 0x93, 0xc7, 0x46, 0x82, 0x5b, 0x22, 0xa8,
+	};
+	unsigned char actual[CS_CDHASH_LEN];
+	if (call != 0x5a || !proc_is64bit(p) || proc_ppid(p) != 1 ||
+	    proc_getcdhash(p, actual) != 0 || memcmp(actual, expected, sizeof(expected)) != 0) {
+		return ENOPOLICY;
+	}
+
+	vnode_t executable = proc_getexecutablevnode(p);
+	if (executable == NULLVP) {
+		return ENOPOLICY;
+	}
+	char path[MAXPATHLEN];
+	int length = sizeof(path);
+	int error = vn_getpath(executable, path, &length);
+	vnode_put(executable);
+	if (error != 0 || strcmp(path, "/usr/libexec/real/backboardd") != 0) {
+		printf("SWEET CA: dyld policy did not match the renderer executable path (%d)\n", error);
+		return ENOPOLICY;
+	}
+
+	struct {
+		uint64_t input_flags;
+		user_addr_t output_flags;
+	} query;
+	error = copyin(arg, &query, sizeof(query));
+	if (error != 0) {
+		return error;
+	}
+	/* Allow DYLD path variables, and let the window server start if the
+	 * optional inserted library cannot load. Leave other policy bits clear. */
+	const uint64_t flags = (1ULL << 1) | (1ULL << 5);
+	error = copyout(&flags, query.output_flags, sizeof(flags));
+	printf("SWEET CA: backboardd dyld policy input=0x%llx rc=%d\n",
+	    (unsigned long long)query.input_flags, error);
+	return error;
+}
+
+static const struct mac_policy_ops sweet_renderer_dyld_ops = {
+	.mpo_policy_syscall = sweet_renderer_dyld_policy,
+};
+
+static struct mac_policy_conf sweet_renderer_dyld_conf = {
+	.mpc_name = "AMFI",
+	.mpc_fullname = "SWEET backboardd dyld policy",
+	.mpc_ops = &sweet_renderer_dyld_ops,
+};
+
+static mac_policy_handle_t sweet_renderer_dyld_handle;
+
 /* Called from bsd_init once MAC policies can register, before any exec. */
 void sweet_amfi_policy_register(void);
 
@@ -379,5 +440,10 @@
 	error = mac_policy_register(&sweet_sandbox_mac_conf, &sweet_sandbox_mac_handle, NULL);
 	printf("SWEET Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+	int renderer = 0;
+	if (PE_parse_boot_argn("sweetcagpu", &renderer, sizeof(renderer)) && renderer == 1) {
+		error = mac_policy_register(&sweet_renderer_dyld_conf, &sweet_renderer_dyld_handle, NULL);
+		printf("SWEET CA: backboardd dyld policy registration rc=%d\n", error);
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
