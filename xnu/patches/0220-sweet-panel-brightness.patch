+/* DSI 6G host registers (Linux drivers/gpu/drm/msm/dsi, dsi.xml.h) */
+#define SWEET_DSI_CTRL                  0x004
+#define   SWEET_DSI_CTRL_ENABLE         (1u << 0)
+#define   SWEET_DSI_CTRL_CMD_MODE_EN    (1u << 2)
+#define SWEET_DSI_STATUS0               0x008
+#define   SWEET_DSI_STATUS0_VIDEO_BUSY  (1u << 3)
+#define SWEET_DSI_CMD_DMA_CTRL          0x03c
+#define   SWEET_DSI_CMD_DMA_LOW_POWER   (1u << 26)
+#define SWEET_DSI_DMA_BASE              0x048
+#define SWEET_DSI_DMA_LEN               0x04c
+#define SWEET_DSI_TRIG_CTRL             0x084
+#define   SWEET_DSI_TRIG_DMA_SW         4u
+#define SWEET_DSI_CMD_DMA_SW_TRIGGER    0x090
+#define SWEET_DSI_INT_CTRL              0x110
+#define   SWEET_DSI_IRQ_CMD_DMA_DONE    (1u << 0)
+
+static inline uint32_t
+sweet_dsi_rd(volatile uint8_t *b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+static inline void
+sweet_dsi_wr(volatile uint8_t *b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* One DCS long write (data type 0x39) through the command DMA; true when the controller says done. */
+bool
+AppleCLCD::dsiDcsLong(const uint8_t *payload, uint32_t len)
+{
+	if (fDsi == NULL || fDsiBuf == NULL || len == 0 || len > 60 || fBlFailures >= 3) {
+		return false;
+	}
+	uint8_t *p = (uint8_t *)fDsiBuf->getBytesNoCopy();
+	uint32_t size = (4 + len + 3) & ~3u;
+	memset(p, 0xff, 64);
+	p[0] = (uint8_t)len;                    /* word count */
+	p[1] = (uint8_t)(len >> 8);
+	p[2] = 0x39;                            /* DCS long write, virtual channel 0 */
+	p[3] = 0xc0;                            /* last command, long packet */
+	memcpy(p + 4, payload, len);
+	flush_dcache64((addr64_t)(uintptr_t)p, 64, FALSE);
+
+	uint32_t ctrl = sweet_dsi_rd(fDsi, SWEET_DSI_CTRL);
+	uint32_t trig = sweet_dsi_rd(fDsi, SWEET_DSI_TRIG_CTRL);
+	uint32_t dma = sweet_dsi_rd(fDsi, SWEET_DSI_CMD_DMA_CTRL);
+	/* Video mode: send between frames (Linux dsi_wait4video_eng_busy), at most 20 ms of waiting. */
+	if (sweet_dsi_rd(fDsi, SWEET_DSI_STATUS0) & SWEET_DSI_STATUS0_VIDEO_BUSY) {
+		uint64_t until = mach_absolute_time(), span;
+		nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &span);
+		until += span;
+		while ((sweet_dsi_rd(fDsi, SWEET_DSI_STATUS0) & SWEET_DSI_STATUS0_VIDEO_BUSY) &&
+		    mach_absolute_time() < until) {
+		}
+	}
+	if ((trig & 7u) != SWEET_DSI_TRIG_DMA_SW) {
+		sweet_dsi_wr(fDsi, SWEET_DSI_TRIG_CTRL, (trig & ~7u) | SWEET_DSI_TRIG_DMA_SW);
+	}
+	sweet_dsi_wr(fDsi, SWEET_DSI_CTRL, ctrl | SWEET_DSI_CTRL_CMD_MODE_EN | SWEET_DSI_CTRL_ENABLE);
+	sweet_dsi_wr(fDsi, SWEET_DSI_INT_CTRL, sweet_dsi_rd(fDsi, SWEET_DSI_INT_CTRL) | SWEET_DSI_IRQ_CMD_DMA_DONE);
+	sweet_dsi_wr(fDsi, SWEET_DSI_DMA_BASE, (uint32_t)fDsiBufPhys);
+	sweet_dsi_wr(fDsi, SWEET_DSI_DMA_LEN, size);
+	sweet_dsi_wr(fDsi, SWEET_DSI_CMD_DMA_CTRL, dma & ~SWEET_DSI_CMD_DMA_LOW_POWER);   /* high speed */
+	sweet_dsi_wr(fDsi, SWEET_DSI_CMD_DMA_SW_TRIGGER, 1);
+	bool done = false;
+	for (int i = 0; i < 50 && !done; i++) {
+		done = (sweet_dsi_rd(fDsi, SWEET_DSI_INT_CTRL) & SWEET_DSI_IRQ_CMD_DMA_DONE) != 0;
+		if (!done) {
+			IODelay(1000);
+		}
+	}
+	sweet_dsi_wr(fDsi, SWEET_DSI_INT_CTRL, sweet_dsi_rd(fDsi, SWEET_DSI_INT_CTRL) | SWEET_DSI_IRQ_CMD_DMA_DONE);
+	sweet_dsi_wr(fDsi, SWEET_DSI_CMD_DMA_CTRL, dma);
+	sweet_dsi_wr(fDsi, SWEET_DSI_CTRL, ctrl);
+	if ((trig & 7u) != SWEET_DSI_TRIG_DMA_SW) {
+		sweet_dsi_wr(fDsi, SWEET_DSI_TRIG_CTRL, trig);
+	}
+	if (!done && ++fBlFailures >= 3) {
+		IOLog("SWEET FB: DSI0 never finished a command; brightness off\n");
+	}
+	return done;
+}
+
+void
+AppleCLCD::setPanelLevel(uint32_t level)
+{
+	uint8_t cmd[3] = { 0x51, (uint8_t)(level >> 8), (uint8_t)level };      /* MSB first (ss-ea) */
+	IOLockLock(fBlLock);
+	bool done = dsiDcsLong(cmd, sizeof(cmd));
+	IOLockUnlock(fBlLock);
+	static uint32_t logs;
+	if (logs++ < 12 || !done) {
+		IOLog("SWEET FB: panel level %#x: %s\n", level, done ? "done" : "NO DONE");
+	}
+}
+
+/* nits in 16.16 (CoreBrightness) -> panel level SWEET_FB_BL_MIN..SWEET_FB_BL_MAX */
+void
+AppleCLCD::setNits16(uint64_t nits16)
+{
+	setProperty("IOMFBBrightnessLevel", nits16, 32);
+	uint64_t level = (nits16 * SWEET_FB_BL_MAX) / ((uint64_t)SWEET_FB_MAX_NITS << 16);
+	if (level > SWEET_FB_BL_MAX) {
+		level = SWEET_FB_BL_MAX;
+	}
+	if (level < SWEET_FB_BL_MIN) {
+		level = SWEET_FB_BL_MIN;
+	}
+	IOLockLock(fLock);
+	fBlLevel = (uint32_t)level;
+	bool off = fPowerOff;
+	IOLockUnlock(fLock);
+	if (!off) {
+		setPanelLevel((uint32_t)level);
+	}
+}
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	OSNumber *n = d != NULL ? OSDynamicCast(OSNumber, d->getObject("IOMFBBrightnessLevel")) : NULL;
+	if (n == NULL || fDsi == NULL) {
+		return kIOReturnUnsupported;
+	}
+	setNits16(n->unsigned64BitValue());
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	OSNumber *n = d != NULL ? OSDynamicCast(OSNumber, d->getObject("brightness-nits")) : NULL;
+	if (n == NULL || fFB == NULL) {
+		return kIOReturnUnsupported;
+	}
+	uint64_t v = n->unsigned64BitValue();
+	setProperty("brightness-nits", n);
+	fFB->setNits16(v < 0x10000 ? v << 16 : v);     /* plain nits or 16.16 */
+	return kIOReturnSuccess;
+}
