+/*
+ * ---- Wi-Fi step 2: the connectivity block on, up to its chip id (rodinwifion=1) ----
+ * Our own code after the sequence of conninfra platform/mt6899 (consys_hw_pwr_on: clock buffer,
+ * PMIC common supplies, D-die <-> A-die pinmux, "conn_infra_on" power domain and bus protection,
+ * chip id polling); the A-die, PLL and low-power steps come later. Register facts from Xiaomi's
+ * bsp-rodin-v-oss (mt6899_pos_gen.c, mt6899_pmic.c, mt6899_soc.c), DT /consys@18000000.
+ */
+#define CONN_CKSYS_PA           0x10000000u     /* +0x1f8 bit 16: conn_von_top_host_ck_req_en off */
+#define CONN_INFRACFG_AO_PA     0x10001000u
+#define CONN_IOCFG_RT_PA        0x11b50000u
+#define CONN_SPM_PA             0x1c001000u
+#define CONN_INFRA_CFG_PA       0x18011000u     /* +0: IP version */
+#define CONN_HW_VER             0x02050403u
+
+static int
+rodin_pmic_update(uint8_t sid, uint16_t addr, uint8_t mask, uint8_t val, const char *what)
+{
+	uint8_t old = 0, now = 0;
+	int e = rodin_pmic_read(sid, addr, &old);
+	if (e == 0 && (old & mask) != val) {
+		e = rodin_pmic_write(sid, addr, (uint8_t)((old & ~mask) | val));
+	}
+	(void)rodin_pmic_read(sid, addr, &now);
+	printf("RODIN WIFI: PMIC %s 0x%04x: 0x%02x -> 0x%02x (err %d)\n", what, addr, old, now, e);
+	return e;
+}
+
+static bool
+rodin_poll_bit(vm_offset_t base, uint32_t off, uint32_t bit, uint32_t want, uint32_t tries, uint32_t us)
+{
+	for (uint32_t i = 0; i < tries; i++) {
+		if (((rd32(base, off) >> bit) & 1u) == want) {
+			return true;
+		}
+		delay(us);
+	}
+	return ((rd32(base, off) >> bit) & 1u) == want;
+}
