+                                    int gmu_status_ok = 1; uint32_t gmu_reset = 0xffffffffu;
                                     for (unsigned i = 0; i < sizeof(off)/sizeof(off[0]); ++i) {
                                         printf("SWEET GPU: about to read GMU +%05x; access may fault\n", 0x14000u + off[i]);
                                         delay(1000000);
@@ -214,7 +255,14 @@
                                         __asm__ volatile ("dmb oshld" ::: "memory");
                                         printf("SWEET GPU: GMU +%05x = %08x%s\n", 0x14000u + off[i], val,
                                             val == 0xffffffffu ? " (unavailable)" : "");
-                                        if (val == 0xffffffffu) break;
+                                        if (i == 0) gmu_reset = val;
+                                        if (val == 0xffffffffu) { gmu_status_ok = 0; break; }
+                                    }
+                                    int gmu_load = 0;
+                                    if (PE_parse_boot_argn("sweetgmuload", &gmu_load, sizeof(gmu_load)) && gmu_load == 1) {
+                                        if (!gmu_status_ok || gmu_reset != 1u)
+                                            printf("SWEET GPU: GMU TCM skipped: reset/status not confirmed\n");
+                                        else gmu_tcm_probe(gmu);
                                     }
                                 }
