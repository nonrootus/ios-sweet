+/* ---- Touch ------------------------------------------------------------------------------- */
+
+#define TP_PIN_IRQ              9u
+#define TP_PIN_SPI_CLK          50u
+#define TP_PIN_SPI_CS           51u
+#define TP_PIN_SPI_MISO         52u
+#define TP_PIN_SPI_MOSI         53u
+#define TP_PIN_AVDD             73u
+#define TP_PIN_RESET            134u
+
+#define SPI1_PA                 0x11011800u
+#define SPI_CFG0                0x00u   /* [31:16] CS setup, [15:0] CS hold (ticks - 1) */
+#define SPI_CFG1                0x04u   /* [31:16] packet length - 1, [15:8] loop, [7:0] CS idle */
+#define SPI_TX_DATA             0x10u
+#define SPI_RX_DATA             0x14u
+#define SPI_CMD                 0x18u
+#define SPI_STATUS0             0x1cu
+#define SPI_STATUS1             0x20u
+#define SPI_PAD_SEL             0x24u
+#define SPI_CFG2                0x28u   /* [31:16] SCK low, [15:0] SCK high (ticks - 1) */
+#define SPI_SLICE_EN            0x5cu
+#define SPI_CFG5                0x68u   /* packet length - 1, high 16 bits */
+#define SPI_CMD_ACT             (1u << 0)
+#define SPI_CMD_RST             (1u << 2)
+#define SPI_CMD_CS_POL          (1u << 7)   /* software CS: 1 = released (high) */
+#define SPI_CMD_TXMSBF          (1u << 12)
+#define SPI_CMD_RXMSBF          (1u << 13)
+#define SPI_CMD_CS_PIN_SEL      (1u << 18)
+#define SPI_CMD_NONIDLE         (1u << 19)
+#define SPI_CMD_TICKDLY_SHIFT   22u     /* 7 bits with slice_en */
+#define SPI_FIFO                32u
+#define SPI_SRC_HZ              208000000u      /* spi1_b_sel 7 = univpll_d6_d2 (xnu8 log) */
+#define SPI_TICKDLY             0x14u           /* DT mediatek,tickdly */
+#define SIP_SPI_CONTROL         0xC2000542ull   /* MTK_SIP_KERNEL_SPI_CONTROL */
+
+#define GDX_BOOTOPTION          0x10000u
+#define GDX_IC_INFO             0x10070u
+#define GDX_IC_INFO_BRA         0x10068u
+#define GDX_MAX_LEN             1024u
+#define GDX_HEAD                8u
+#define GDX_POINT               8u
+#define GDX_FINGERS             10u
+
+static vm_offset_t spi;
+static uint32_t gdx_dummy = 3;          /* dummy bytes after a read address: 3, or 4 on Berlin-A */
+static uint32_t gdx_touch_addr;
+static uint8_t gdx_tx[8 + GDX_MAX_LEN], gdx_rx[8 + GDX_MAX_LEN];
+
+static void
+pin_field(uint32_t base, unsigned pin, unsigned per, unsigned bits, uint32_t val)
+{
+	uint32_t off = base + (pin / per) * 0x10u, sh = (pin % per) * bits, mask = ((1u << bits) - 1u) << sh;
+	wr32(gpio, off, (rd32(gpio, off) & ~mask) | ((val << sh) & mask));
+}
+
+static void
+pin_mode(unsigned pin, unsigned mode)
+{
+	pin_field(0x300u, pin, 8u, 4u, mode);
+}
+
+static void
+pin_out(unsigned pin, bool high)        /* level first, then direction: no glitch */
+{
+	pin_field(0x100u, pin, 32u, 1u, high);
+	pin_field(0x000u, pin, 32u, 1u, 1u);
+}
+
+static void
+pin_in(unsigned pin)
+{
+	pin_field(0x000u, pin, 32u, 1u, 0u);
+}
+
+static uint64_t
+rodin_smc3(uint64_t fid, uint64_t a1, uint64_t a2)
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
+	    "memory");
+	return x0;
+}
+
+/* One full-duplex transfer with chip select held: FIFO chunks of 32 bytes, polled. */
+static int
+spi_xfer(const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	int error = 0;
+
+	wr32(spi, SPI_CMD, rd32(spi, SPI_CMD) & ~SPI_CMD_CS_POL);
+	for (uint32_t done = 0; done < len && !error;) {
+		uint32_t n = MIN(len - done, SPI_FIFO), w;
+		wr32(spi, SPI_CFG1, (rd32(spi, SPI_CFG1) & 0x000000ffu) | ((n - 1u) << 16));
+		wr32(spi, SPI_CFG5, 0);
+		for (uint32_t i = 0; i < n; i += 4) {
+			w = 0;
+			if (tx) {
+				memcpy(&w, tx + done + i, MIN(4u, n - i));
+			}
+			wr32(spi, SPI_TX_DATA, w);
+		}
+		wr32(spi, SPI_CMD, rd32(spi, SPI_CMD) | SPI_CMD_ACT);
+		unsigned t;
+		for (t = 0; t < 20000 && rd32(spi, SPI_STATUS1) == 0; t++) {
+			delay(1);
+		}
+		if (t == 20000) {
+			error = ETIMEDOUT;
+		}
+		(void)rd32(spi, SPI_STATUS0);
+		for (uint32_t i = 0; i < n; i += 4) {
+			w = rd32(spi, SPI_RX_DATA);
+			if (rx) {
+				memcpy(rx + done + i, &w, MIN(4u, n - i));
+			}
+		}
+		done += n;
+	}
+	wr32(spi, SPI_CMD, rd32(spi, SPI_CMD) | SPI_CMD_CS_POL);
+	return error;
+}
+
+static int
+gdx_read(uint32_t addr, uint8_t *data, uint32_t len)
+{
+	uint32_t pre = 5 + gdx_dummy;
+	if (len == 0 || len > GDX_MAX_LEN) {
+		return EINVAL;
+	}
+	bzero(gdx_tx, pre + len);
+	gdx_tx[0] = 0xf1;
+	gdx_tx[1] = (uint8_t)(addr >> 24);
+	gdx_tx[2] = (uint8_t)(addr >> 16);
+	gdx_tx[3] = (uint8_t)(addr >> 8);
+	gdx_tx[4] = (uint8_t)addr;
+	memset(gdx_tx + 5, 0xff, gdx_dummy);
+	int error = spi_xfer(gdx_tx, gdx_rx, pre + len);
+	memcpy(data, gdx_rx + pre, len);
+	return error;
+}
+
+/* Writes only to the boot option (device confirm) and the touch data sync byte. */
+static int
+gdx_write(uint32_t addr, const uint8_t *data, uint32_t len)
+{
+	if (!((addr == GDX_BOOTOPTION && len == 8) || (gdx_touch_addr && addr == gdx_touch_addr && len == 1))) {
+		printf("RODIN TOUCH: refusing a write of %u bytes to 0x%x\n", len, addr);
+		return EPERM;
+	}
+	gdx_tx[0] = 0xf0;
+	gdx_tx[1] = (uint8_t)(addr >> 24);
+	gdx_tx[2] = (uint8_t)(addr >> 16);
+	gdx_tx[3] = (uint8_t)(addr >> 8);
+	gdx_tx[4] = (uint8_t)addr;
+	memcpy(gdx_tx + 5, data, len);
+	return spi_xfer(gdx_tx, NULL, 5 + len);
+}
+
+static bool
+gdx_checksum_ok(const uint8_t *d, uint32_t size)    /* u8 sum, little-endian u16 at the end */
+{
+	uint32_t sum = 0;
+	if (size < 2) {
+		return false;
+	}
+	for (uint32_t i = 0; i < size - 2; i++) {
+		sum += d[i];
+	}
+	return (sum & 0xffffu) == (uint32_t)(d[size - 2] | (d[size - 1] << 8));
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* VTP (1.8 V I/O) on: the one PMIC write. Called before any other thread uses the PMIF. */
+static int
+rodin_touch_vtp_on(void)
+{
+	uint8_t vosel = 0, en = 0;
+	int e = rodin_pmic_read(MT6368_SID, MT6368_VTP_VOSEL, &vosel);
+	if (!e) {
+		e = rodin_pmic_read(MT6368_SID, MT6368_LDO_VTP_EN, &en);
+	}
+	if (e || (vosel & 0xfu) != MT6368_VTP_VOSEL_1V8) {
+		printf("RODIN TOUCH: VTP voltage select 0x%02x (err %d) is not 1.8 V: VTP left off\n", vosel, e);
+		return e ? e : EINVAL;
+	}
+	if (!(en & 1u)) {
+		e = rodin_pmic_write(MT6368_SID, MT6368_LDO_VTP_EN, (uint8_t)(en | 1u));
+		uint8_t now = 0;
+		int r = rodin_pmic_read(MT6368_SID, MT6368_LDO_VTP_EN, &now);
+		printf("RODIN TOUCH: VTP enable 0x%02x -> 0x%02x (write err %d, read err %d)\n", en, now, e, r);
+		if (e || r || !(now & 1u)) {
+			return e ? e : EIO;
+		}
+	}
+	return 0;
+}
+
+static int
+rodin_touch_spi_init(uint32_t hz)
+{
+	uint64_t r = rodin_smc3(SIP_SPI_CONTROL, 0 /* request infra */, 0 /* bus 0: the only SPI */);
+	uint32_t cmd = rd32(spi, SPI_CMD);
+	printf("RODIN TOUCH: SPI infra request -> %lld, SPI1 CMD 0x%08x CFG0 0x%08x CFG1 0x%08x\n",
+	    (long long)r, cmd, rd32(spi, SPI_CFG0), rd32(spi, SPI_CFG1));
+	wr32(spi, SPI_CMD, cmd | SPI_CMD_RST);
+	wr32(spi, SPI_CMD, cmd & ~SPI_CMD_RST);
+	/* Mode 0, MSB first, little-endian FIFO words, no DMA or IRQ, software CS released. */
+	wr32(spi, SPI_CMD, SPI_CMD_NONIDLE | SPI_CMD_CS_PIN_SEL | SPI_CMD_TXMSBF | SPI_CMD_RXMSBF |
+	    SPI_CMD_CS_POL | ((SPI_TICKDLY & 0x7fu) << SPI_CMD_TICKDLY_SHIFT));
+	wr32(spi, SPI_PAD_SEL, 0);
+	wr32(spi, SPI_SLICE_EN, (rd32(spi, SPI_SLICE_EN) & ~0x3fu) | (1u << 0) | (1u << 3));
+	uint32_t div = (SPI_SRC_HZ + hz - 1) / hz, sck = (div + 1) / 2;
+	wr32(spi, SPI_CFG2, ((sck - 1) << 16) | (sck - 1));
+	wr32(spi, SPI_CFG0, ((2 * sck - 1) << 16) | (2 * sck - 1));
+	wr32(spi, SPI_CFG1, (2 * sck - 1) & 0xffu);
+	printf("RODIN TOUCH: SPI1 at %u Hz (SCK %u+%u ticks of 208 MHz), CMD 0x%08x\n",
+	    SPI_SRC_HZ / (2 * sck), sck, sck, rd32(spi, SPI_CMD));
+	return 0;
+}
+
+/* Device confirm (Linux brl_dev_confirm): 8 x 0xAA to the boot option, read back. */
+static bool
+gdx_confirm(void)
+{
+	static const uint8_t aa[8] = { 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa };
+	uint8_t back[8];
+	for (int i = 0; i < 3; i++) {
+		int e = gdx_write(GDX_BOOTOPTION, aa, 8);
+		if (!e) {
+			e = gdx_read(GDX_BOOTOPTION, back, 8);
+		}
+		printf("RODIN TOUCH: confirm (%u dummy) err %d read %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    gdx_dummy, e, back[0], back[1], back[2], back[3], back[4], back[5], back[6], back[7]);
+		if (!e && memcmp(aa, back, 8) == 0) {
+			return true;
+		}
+		rodin_wait_ms(5);
+	}
+	return false;
+}
+
+static uint8_t gdx_info[GDX_MAX_LEN];
+
+static int
+gdx_read_info(void)
+{
+	uint32_t at = gdx_dummy == 4 ? GDX_IC_INFO_BRA : GDX_IC_INFO;
+	uint8_t l[2];
+	int e = gdx_read(at, l, 2);
+	uint32_t len = (uint32_t)(l[0] | (l[1] << 8));
+	if (e || len < 64 || len >= GDX_MAX_LEN) {
+		printf("RODIN TOUCH: IC info length %u at 0x%x (err %d)\n", len, at, e);
+		return e ? e : EINVAL;
+	}
+	e = gdx_read(at, gdx_info, len);
+	if (e || !gdx_checksum_ok(gdx_info, len)) {
+		printf("RODIN TOUCH: IC info read err %d or bad checksum (%u bytes)\n", e, len);
+		return e ? e : EIO;
+	}
+	const uint8_t *v = gdx_info + 2, *p = gdx_info + 2 + 16 + 10;
+	unsigned drv = p[0], sen = p[1];
+	p += 4;
+	for (int k = 0; k < 5; k++) {   /* scan rates, mutual, self tx, self rx, stylus freqs */
+		unsigned n = *p++;
+		if (n > 8) {
+			printf("RODIN TOUCH: IC info list %d has %u entries\n", k, n);
+			return EINVAL;
+		}
+		p += 2 * n;
+	}
+	if (p + 52 > gdx_info + len) {
+		return EINVAL;
+	}
+	gdx_touch_addr = le32(p + 44);
+	printf("RODIN TOUCH: IC info %u bytes: customer %02x version %02x die %02x ic %02x config %08x, "
+	    "%ux%u channels, touch data at 0x%x (head %u, point %u bytes)\n", len, v[0], v[1], v[2], v[3],
+	    le32(v + 4), drv, sen, gdx_touch_addr, p[48] | (p[49] << 8), p[50] | (p[51] << 8));
+	return gdx_touch_addr ? 0 : EINVAL;
+}
+
+static void
+rodin_touch_thread(void *arg, wait_result_t result)
+{
+	static const uint8_t zero = 0;
+	uint8_t buf[GDX_HEAD + GDX_POINT * GDX_FINGERS + 2];
+	bool down[GDX_FINGERS] = { false }, edge[GDX_FINGERS] = { false };
+	int32_t lx[GDX_FINGERS] = { 0 }, ly[GDX_FINGERS] = { 0 };
+	uint32_t mhz = 5, scale_x = 1220, scale_y = 2712, logged = 0, errors = 0;
+	int scale = 0;
+
+	(void)arg;
+	(void)result;
+	PE_parse_boot_argn("rodintouchmhz", &mhz, sizeof(mhz));
+	PE_parse_boot_argn("rodintouchscale", &scale, sizeof(scale));
+	if (scale > 0) {
+		scale_x = 1220u * (uint32_t)scale;
+		scale_y = 2712u * (uint32_t)scale;
+	}
+	mhz = mhz < 1 ? 1 : (mhz > 15 ? 15 : mhz);
+	/* Pins: SPI1 to the AP (mode 1), IRQ input, AVDD on after VTP, then reset released. */
+	pin_in(TP_PIN_IRQ);
+	pin_mode(TP_PIN_IRQ, 0);
+	pin_mode(TP_PIN_SPI_CLK, 1);
+	pin_mode(TP_PIN_SPI_CS, 1);
+	pin_mode(TP_PIN_SPI_MISO, 1);
+	pin_mode(TP_PIN_SPI_MOSI, 1);
+	rodin_wait_ms(3);
+	pin_mode(TP_PIN_AVDD, 0);
+	pin_out(TP_PIN_AVDD, true);
+	rodin_wait_ms(15);
+	pin_mode(TP_PIN_RESET, 0);
+	pin_out(TP_PIN_RESET, true);
+	rodin_wait_ms(4);
+	rodin_touch_spi_init(mhz * 1000000u);
+	if (!gdx_confirm()) {
+		gdx_dummy = 4;          /* Berlin-A reads have one more dummy byte */
+		if (!gdx_confirm()) {
+			printf("RODIN TOUCH: no Goodix answer; touch off\n");
+			rodin_log_pin("touch IRQ", TP_PIN_IRQ);
+			return;
+		}
+	}
+	rodin_wait_ms(100);
+	if (gdx_read_info()) {
+		printf("RODIN TOUCH: no usable IC info; touch off\n");
+		return;
+	}
+	printf("RODIN TOUCH: polling every 8 ms; coordinates %s\n",
+	    scale > 0 ? "scaled by rodintouchscale" : "auto-scaled (x1 or x10 of 1220x2712)");
+	for (;;) {
+		rodin_wait_ms(8);
+		if (gdx_read(gdx_touch_addr, buf, GDX_HEAD + 2 * GDX_POINT + 2)) {
+			if (errors++ % 1000 == 0) {
+				printf("RODIN TOUCH: read error\n");
+			}
