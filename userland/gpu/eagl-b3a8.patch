+struct b3a8_planes {
+	uint8_t *rgb, *alpha;
+	size_t rgb_stride, alpha_stride;
+};
+
+static bool
+b3a8_layout(IOSurfaceRef surface, struct b3a8_planes *planes)
+{
+	size_t width = IOSurfaceGetWidth(surface), height = IOSurfaceGetHeight(surface);
+	size_t length = IOSurfaceGetAllocSize(surface);
+	/* Bound scratch storage independently of the reported surface allocation. */
+	if (width == 0 || height == 0 || width > 8192 || height > 8192 ||
+	    width * height > (64u << 20) / 4u || IOSurfaceGetPlaneCount(surface) != 2) {
+		return false;
+	}
+
+	uintptr_t base = (uintptr_t)IOSurfaceGetBaseAddress(surface);
+	uint8_t *addresses[2];
+	size_t strides[2], ends[2], offsets[2];
+	for (size_t i = 0; i < 2; i++) {
+		size_t bytes = i == 0 ? 4 : 1;
+		uintptr_t address = (uintptr_t)IOSurfaceGetBaseAddressOfPlane(surface, i);
+		size_t stride = IOSurfaceGetBytesPerRowOfPlane(surface, i);
+		if (!base || !address || address < base ||
+		    IOSurfaceGetWidthOfPlane(surface, i) < width ||
+		    IOSurfaceGetHeightOfPlane(surface, i) < height ||
+		    IOSurfaceGetBytesPerElementOfPlane(surface, i) != bytes ||
+		    IOSurfaceGetElementWidthOfPlane(surface, i) != 1 ||
+		    IOSurfaceGetElementHeightOfPlane(surface, i) != 1 ||
+		    !sweet_b3a8_plane_fits(address - base, stride, width * bytes, height, length)) {
+			return false;
+		}
+		addresses[i] = (uint8_t *)address;
+		strides[i] = stride;
+		offsets[i] = address - base;
+		ends[i] = offsets[i] + stride * (height - 1) + width * bytes;
+	}
+	if (offsets[0] < ends[1] && offsets[1] < ends[0]) {
+		return false;
+	}
+	*planes = (struct b3a8_planes){ addresses[0], addresses[1], strides[0], strides[1] };
+	return true;
+}
+
+static uint8_t *
+b3a8_scratch(struct eagl *e, const struct image *image)
+{
+	size_t bytes = (size_t)image->width * (size_t)image->height * 4;
+	if (bytes > e->b3a8_capacity) {
+		uint8_t *pixels = realloc(e->b3a8_pixels, bytes);
+		if (pixels == NULL) {
+			return NULL;
+		}
+		e->b3a8_pixels = pixels;
+		e->b3a8_capacity = bytes;
+	}
+	return e->b3a8_pixels;
+}
+
+/* Mesa owns a regular RGBA8 render target. Preserve pixel-transfer state when
+ * moving a tightly packed CPU buffer to or from it. */
+static void
+b3a8_transfer_state(bool pack, GLint saved[5], bool restore)
+{
+	const GLenum pack_state[] = { GL_PACK_ALIGNMENT, GL_PACK_ROW_LENGTH,
+	    GL_PACK_SKIP_PIXELS, GL_PACK_SKIP_ROWS, GL_PIXEL_PACK_BUFFER_BINDING };
+	const GLenum unpack_state[] = { GL_UNPACK_ALIGNMENT, GL_UNPACK_ROW_LENGTH,
+	    GL_UNPACK_SKIP_PIXELS, GL_UNPACK_SKIP_ROWS, GL_PIXEL_UNPACK_BUFFER_BINDING };
+	const GLenum *state = pack ? pack_state : unpack_state;
+	GLenum buffer = pack ? GL_PIXEL_PACK_BUFFER : GL_PIXEL_UNPACK_BUFFER;
+	for (unsigned i = 0; i < 4; i++) {
+		if (!restore) {
+			glGetIntegerv(state[i], &saved[i]);
+		}
+		glPixelStorei(state[i], restore ? saved[i] : i == 0);
+	}
+	if (!restore) {
+		glGetIntegerv(state[4], &saved[4]);
+	}
+	glBindBuffer(buffer, restore ? (GLuint)saved[4] : 0);
+}
+
+static bool
+b3a8_upload(struct eagl *e, struct image *image)
+{
+	IOSurfaceRef surface = image->surface;
+	struct b3a8_planes planes;
+	if (IOSurfaceLock(surface, kIOSurfaceLockReadOnly, NULL) != 0) {
+		return false;
+	}
+	uint8_t *pixels = b3a8_layout(surface, &planes) ? b3a8_scratch(e, image) : NULL;
+	if (pixels != NULL) {
+		for (GLsizei y = 0; y < image->height; y++) {
+			size_t row = (size_t)(image->invert ? image->height - 1 - y : y);
+			const uint8_t *rgb = planes.rgb + row * planes.rgb_stride;
+			const uint8_t *alpha = planes.alpha + row * planes.alpha_stride;
+			uint8_t *rgba = pixels + (size_t)y * image->width * 4;
+			for (GLsizei x = 0; x < image->width; x++) {
+				uint32_t word;
+				memcpy(&word, rgb + 4 * x, sizeof(word));
+				sweet_b3a8_unpack(word, alpha[x], rgba + 4 * x, 0);
+			}
+		}
+	}
+	IOSurfaceUnlock(surface, kIOSurfaceLockReadOnly, NULL);
+	if (pixels == NULL) {
+		return false;
+	}
+
+	GLint saved[5];
+	b3a8_transfer_state(false, saved, false);
+	glGetError();
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, image->width, image->height, 0,
+	    GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	GLenum error = glGetError();
+	b3a8_transfer_state(false, saved, true);
+	if (error != GL_NO_ERROR) {
+		say("redwood-gl: b3a8 texture allocation failed: %#x\n", error);
+		return false;
+	}
+	image->seed = IOSurfaceGetSeed(surface);
+	e->uploads++;
+	e->upload_bytes += (size_t)image->width * image->height * 4;
+	return true;
+}
+
+static void
+b3a8_readback(struct eagl *e, struct image *image)
+{
+	IOSurfaceRef surface = image->surface;
+	struct b3a8_planes planes;
+	uint8_t *pixels = b3a8_scratch(e, image);
+	if (pixels == NULL || glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+		say("redwood-gl: b3a8 readback target incomplete\n");
+		return;
+	}
+
+	GLint saved[5];
+	b3a8_transfer_state(true, saved, false);
+	glGetError();
+	glReadPixels(0, 0, image->width, image->height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	GLenum error = glGetError();
+	b3a8_transfer_state(true, saved, true);
+	if (error != GL_NO_ERROR) {
+		say("redwood-gl: b3a8 readback failed: %#x\n", error);
+		return;
+	}
+	if (IOSurfaceLock(surface, 0, NULL) != 0) {
+		return;
+	}
+	if (b3a8_layout(surface, &planes)) {
+		for (GLsizei y = 0; y < image->height; y++) {
+			size_t row = (size_t)(image->invert ? image->height - 1 - y : y);
+			uint8_t *rgb = planes.rgb + row * planes.rgb_stride;
+			uint8_t *alpha = planes.alpha + row * planes.alpha_stride;
+			const uint8_t *rgba = pixels + (size_t)y * image->width * 4;
+			for (GLsizei x = 0; x < image->width; x++, rgba += 4) {
+				uint32_t word = sweet_b3a8_pack(rgba);
+				memcpy(rgb + 4 * x, &word, sizeof(word));
+				alpha[x] = rgba[3];
+			}
+		}
+		if (e->frames < 4) {
+			say("redwood-gl: b3a8 readback surface %u, %dx%d\n",
+			    IOSurfaceGetID(surface), image->width, image->height);
+		}
+	}
+	IOSurfaceUnlock(surface, 0, NULL);
+}
