     IOLog("SWEET A618 CP: ROQ fence DWORD=%05x first=%08x settled=%08x ctl=%08x status=%08x clock=%08x\n",
         reg, first, settled, control, status, clock);
-    if (control || status == UINT32_MAX || (status & 3u) ||
