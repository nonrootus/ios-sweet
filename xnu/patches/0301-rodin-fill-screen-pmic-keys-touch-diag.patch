+/*
+ * Fill mode: one layer's logical rect (dx,dy,w,h), read from (sx,sy) of its
+ * surface, onto every panel pixel whose frame pixel (fMapX/fMapY) lies in the
+ * rect. Each panel row is built in fRow (cached) and copied once; rows that
+ * map to the same frame row reuse it. Runs on the vsync work loop only.
+ */
+void
+AppleCLCD::presentFill(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	uintptr_t src = s->kernelAddress();
+	const size_t length = s->memory ? s->memory->getLength() : 0;
+	if (w <= 0 || h <= 0 || src == 0 || length == 0) {
+		return;
+	}
+	const bool b3a8 = s->pixelFormat == SWEET_B3A8_FORMAT;
+	if (b3a8) {
+		const auto &rgb = s->planes[0];
+		const auto &alpha = s->planes[1];
+		if (s->planeCount != 2 ||
+		    !sweet_b3a8_display_plane(rgb, 4, sx + w, sy + h, length) ||
+		    !sweet_b3a8_display_plane(alpha, 1, sx + w, sy + h, length) ||
+		    !((uint64_t)rgb.offset + rgb.size <= alpha.offset ||
+		    (uint64_t)alpha.offset + alpha.size <= rgb.offset)) {
+			return;
+		}
+	} else {
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		if (bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || last > length) {
+			return;
+		}
+	}
+	/* Panel columns/rows whose frame pixel lies in the rect: [p0, p1). */
+	uint32_t px0 = (uint32_t)(((uint64_t)dx * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) * fWidth + fLogicalW - 1) / fLogicalW);
+	uint32_t py0 = (uint32_t)(((uint64_t)dy * fHeight + fLogicalH - 1) / fLogicalH);
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) * fHeight + fLogicalH - 1) / fLogicalH);
+	px1 = px1 > fWidth ? fWidth : px1;
+	py1 = py1 > fHeight ? fHeight : py1;
+	if (px0 >= px1 || py0 >= py1) {
+		return;
+	}
+	int32_t built = -1;
+	for (uint32_t py = py0; py < py1; py++) {
+		int32_t fy = fMapY[py];
+		if (fy != built) {
+			built = fy;
+			uint64_t srow = (uint64_t)(sy + fy - dy);
+			if (b3a8) {
+				const auto &rgb = s->planes[0];
+				const auto &alpha = s->planes[1];
+				const uint8_t *colors = (const uint8_t *)(src + rgb.offset + srow * rgb.bytesPerRow);
+				const uint8_t *opacities = (const uint8_t *)(src + alpha.offset + srow * alpha.bytesPerRow);
+				for (uint32_t px = px0; px < px1; px++) {
+					uint32_t scol = (uint32_t)(sx + fMapX[px] - dx);
+					uint32_t word;
+					memcpy(&word, colors + (uint64_t)scol * 4, sizeof(word));
+					sweet_b3a8_unpack(word, opacities[scol], fRow + (px - px0) * 4, 1);
+				}
+			} else {
+				const uint8_t *row = (const uint8_t *)(src + s->offset + srow * s->bytesPerRow);
+				for (uint32_t px = px0; px < px1; px++) {
+					uint32_t scol = (uint32_t)(sx + fMapX[px] - dx);
+					memcpy(fRow + (px - px0) * 4, row + (uint64_t)scol * 4, 4);
+				}
+			}
+		}
+		memcpy((void *)(fPixels + (uint64_t)py * fRowBytes + (uint64_t)px0 * 4), fRow,
+		    (size_t)(px1 - px0) * 4);
+	}
+}
