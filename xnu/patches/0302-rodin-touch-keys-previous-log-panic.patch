+			    buf + GDX_HEAD + 2 * GDX_POINT + 2, (n - 2) * GDX_POINT) == 0;
+		}
+		if (ok && n > 0) {
+			ok = gdx_checksum_ok(buf + GDX_HEAD, n * GDX_POINT + 2);
+		}
+		(void)gdx_write(gdx_touch_addr, &zero, 1);     /* event read */
+		if (!ok || !(buf[0] & 0x80)) {
+			continue;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			const uint8_t *pt = buf + GDX_HEAD + i * GDX_POINT;
+			uint32_t id = pt[0] >> 4, x = (uint32_t)(pt[2] | (pt[3] << 8)), y = (uint32_t)(pt[4] | (pt[5] << 8));
+			if (id >= GDX_FINGERS || (pt[0] & 0x0f) == 0x01 || (pt[0] & 0x0f) == 0x03) {
+				continue;       /* stylus */
+			}
+			if (scale <= 0) {   /* the first value past 1220/2712 shows x10 units */
+				scale_x = x >= scale_x ? 12200u : scale_x;
+				scale_y = y >= scale_y ? 27120u : scale_y;
+			}
+			if (logged < 40) {
+				logged++;
+				printf("RODIN TOUCH: raw id %u type %u x %u y %u w %u -> /%u /%u\n", id, pt[0] & 0x0f,
+				    x, y, pt[6] | (pt[7] << 8), scale_x, scale_y);
+			}
+			int32_t nx = (int32_t)(((uint64_t)MIN(x, scale_x - 1) << 16) / scale_x);
+			int32_t ny = (int32_t)(((uint64_t)MIN(y, scale_y - 1) << 16) / scale_y);
+			if (!down[id]) {
+				/* 48 px of the 1080 px sweet panel, as SweetHID.cpp: 4.4% wide, 2% tall */
+				edge[id] = nx < 2900 || nx > 65536 - 2900 || ny < 1310 || ny > 65536 - 1310;
+			}
+			seen[id] = true;
+			down[id] = true;
+			lx[id] = nx;
+			ly[id] = ny;
+			sweet_hid_touch_norm((int)id, 1, nx, ny, edge[id]);
+		}
+		for (uint32_t id = 0; id < GDX_FINGERS; id++) {
+			if (down[id] && !seen[id]) {
+				down[id] = false;
+				sweet_hid_touch_norm((int)id, 0, lx[id], ly[id], edge[id]);
+			}
+		}
+	}
+}
