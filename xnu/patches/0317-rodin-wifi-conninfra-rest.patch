+/*
+ * Wi-Fi step 2c: the rest of conninfra's first power-on, as data. The tables below hold only
+ * register facts (operation, physical address, value, mask) taken from Xiaomi's bsp-rodin-v-oss
+ * conninfra platform/mt6899/mt6899_pos_gen.c functions named above each table, with the branches
+ * this phone takes (A-die 0x66378a01: PART2's 0x8a01 writes and sleep mode 3; VS2 power mode 1;
+ * the RC-mode branch chosen at run time from SRCLKEN_RC CENTRAL_CFG1 bit 0).
+ * Operations: 1 write, 2 masked write, 3 set bits, 4 clear bits, 5 poll bit a for value b (v tries,
+ * m us apart), 6 delay v us, 7 A-die (MT6637) TOP SPI write of v at address pa.
+ */
+struct rodin_conn_op {
+	uint8_t op, a, b;
+	uint32_t pa, v, m;
+};
